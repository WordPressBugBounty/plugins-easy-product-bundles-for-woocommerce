42\u043a\u043e\u0442\u043e \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u0432 \u043a\u0430\u0440\u0442\u0430\u0442\u0430 \u043d\u0430 \u0435\u043b\u0435\u043c\u0435\u043d\u0442\u0430 \u043e\u0442 \u043f\u0430\u043a\u0435\u0442\u0430. \u0414\u0435\u0430\u043a\u0442\u0438\u0432\u0438\u0440\u0430\u0439\u0442\u0435 \u0442\u0430\u0437\u0438 \u043e\u043f\u0446\u0438\u044f, \u0437\u0430 \u0434\u0430 \u0433\u043e \u0441\u043a\u0440\u0438\u0435\u0442\u0435 \u0432 \u043f\u043e\u043b\u0435\u0442\u043e \u043d\u0430 \u0435\u043b\u0435\u043c\u0435\u043d\u0442\u0430."],"Prepend parent name":["\u0414\u043e\u0431\u0430\u0432\u0435\u0442\u0435 \u043f\u0440\u0435\u0434\u0438 \u0438\u043c\u0435\u0442\u043e \u043d\u0430 \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u044f"],"Prepend the parent name to the item name in the cart and order.":["\u0414\u043e\u0431\u0430\u0432\u0435\u0442\u0435 \u0438\u043c\u0435\u0442\u043e \u043d\u0430 \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u044f \u043f\u0440\u0435\u0434 \u0438\u043c\u0435\u0442\u043e \u043d\u0430 \u0430\u0440\u0442\u0438\u043a\u0443\u043b\u0430 \u0432 \u043a\u043e\u043b\u0438\u0447\u043a\u0430\u0442\u0430 \u0438 \u043f\u043e\u0440\u044a\u0447\u043a\u0430\u0442\u0430"],"Show \u201cbundled\u201d in suffix":["\u041f\u043e\u043a\u0430\u0437\u0432\u0430\u043d\u0435 \u043d\u0430 \u201e\u043f\u0430\u043a\u0435\u0442\u0438\u0440\u0430\u043d\u201c \u0432 \u043d\u0430\u0441\u0442\u0430\u0432\u043a\u0430\u0442\u0430"],"Show the \u201cBundled in [Parent Product]\u201d text after each bundled item\u2019s name in the order details section.":["\u041f\u043e\u043a\u0430\u0437\u0432\u0430\u043d\u0435 \u043d\u0430 \u0442\u0435\u043a\u0441\u0442\u0430 \u201e\u0427\u0430\u0441\u0442 \u043e\u0442 \u043f\u0430\u043a\u0435\u0442 [\u043e\u0441\u043d\u043e\u0432\u0435\u043d \u043f\u0440\u043e\u0434\u0443\u043a\u0442]\u201c \u0441\u043b\u0435\u0434 \u0438\u043c\u0435\u0442\u043e \u043d\u0430 \u0432\u0441\u0435\u043a\u0438 \u0432\u043a\u043b\u044e\u0447\u0435\u043d \u0432 \u043f\u0430\u043a\u0435\u0442\u0430 \u0430\u0440\u0442\u0438\u043a\u0443\u043b \u0432 \u0440\u0430\u0437\u0434\u0435\u043b\u0430 \u0441 \u0434\u0435\u0442\u0430\u0439\u043b\u0438 \u043d\u0430 \u043f\u043e\u0440\u044a\u0447\u043a\u0430\u0442\u0430."],"Hide out of stock":["\u0421\u043a\u0440\u0438\u0439\u0442\u0435 \u0438\u0437\u0447\u0435\u0440\u043f\u0430\u043d\u0438\u0442\u0435 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438"],"Hide out of stock products.":["\u0421\u043a\u0440\u0438\u0439\u0442\u0435 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0442\u0435, \u043a\u043e\u0438\u0442\u043e \u0441\u0430 \u0438\u0437\u0447\u0435\u0440\u043f\u0430\u043d\u0438."],"Show price in cart":["\u041f\u043e\u043a\u0430\u0436\u0438 \u0446\u0435\u043d\u0430 \u0432 \u043a\u043e\u043b\u0438\u0447\u043a\u0430\u0442\u0430"],"Product bundle items price visibility in cart and checkout.":["\u0412\u0438\u0434\u0438\u043c\u043e\u0441\u0442 \u043d\u0430 \u0446\u0435\u043d\u0438\u0442\u0435 \u0437\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u043e\u0432\u0438 \u043f\u0430\u043a\u0435\u0442\u0438 \u0432 \u043a\u043e\u043b\u0438\u0447\u043a\u0430\u0442\u0430 \u0438 \u043d\u0430 \u0447\u0435\u043a\u0430\u0443\u0442."],"Show products list":["\u041f\u043e\u043a\u0430\u0436\u0438 \u0441\u043f\u0438\u0441\u044a\u043a \u0441 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438"],"Show products list below products bundle.":["\u041f\u043e\u043a\u0430\u0436\u0438 \u0441\u043f\u0438\u0441\u044a\u043a \u0441 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438 \u043f\u043e\u0434 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u043e\u0432\u0438\u044f \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0442."],"Show total price":["\u041f\u043e\u043a\u0430\u0436\u0438 \u043e\u0431\u0449\u0430\u0442\u0430 \u0446\u0435\u043d\u0430"],"Show the total price of the selected items below the products list.":["\u041f\u043e\u043a\u0430\u0436\u0438 \u043e\u0431\u0449\u0430\u0442\u0430 \u0446\u0435\u043d\u0430 \u043d\u0430 \u0438\u0437\u0431\u0440\u0430\u043d\u0438\u0442\u0435 \u0430\u0440\u0442\u0438\u043a\u0443\u043b\u0438 \u043f\u043e\u0434 \u0441\u043f\u0438\u0441\u044a\u043a\u0430 \u0441 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438."],"Show saved money":["\u041f\u043e\u043a\u0430\u0437\u0432\u0430\u043d\u0435 \u043d\u0430 \u0441\u043f\u0435\u0441\u0442\u0435\u043d\u0438 \u043f\u0430\u0440\u0438"],"Show the saved money when calculating the total price.":["\u041f\u043e\u043a\u0430\u0437\u0432\u0430\u043d\u0435 \u043d\u0430 \u0441\u043f\u0435\u0441\u0442\u0435\u043d\u0438\u0442\u0435 \u043f\u0430\u0440\u0438 \u043f\u0440\u0438 \u0438\u0437\u0447\u0438\u0441\u043b\u044f\u0432\u0430\u043d\u0435 \u043d\u0430 \u043e\u0431\u0449\u0430\u0442\u0430 \u0446\u0435\u043d\u0430."],"Show Discount Badge":["\u041f\u043e\u043a\u0430\u0437\u0432\u0430\u043d\u0435 \u043d\u0430 \u0437\u043d\u0430\u0447\u043a\u0430\u0442\u0430 \u0437\u0430 \u043e\u0442\u0441\u0442\u044a\u043f\u043a\u0430"],"Show or hide the discount badge in the bundle total price section.":["\u041f\u043e\u043a\u0430\u0437\u0432\u0430\u043d\u0435 \u0438\u043b\u0438 \u0441\u043a\u0440\u0438\u0432\u0430\u043d\u0435 \u043d\u0430 \u0437\u043d\u0430\u0447\u043a\u0430\u0442\u0430 \u0437\u0430 \u043e\u0442\u0441\u0442\u044a\u043f\u043a\u0430 \u0432 \u0441\u0435\u043a\u0446\u0438\u044f\u0442\u0430 \u0437\u0430 \u043e\u0431\u0449\u0430\u0442\u0430 \u0446\u0435\u043d\u0430 \u043d\u0430 \u043f\u0430\u043a\u0435\u0442\u0430."],"Show selected product quick view":["\u041f\u043e\u043a\u0430\u0436\u0438 \u0431\u044a\u0440\u0437\u0438\u044f \u043f\u0440\u0435\u0433\u043b\u0435\u0434 \u043d\u0430 \u0438\u0437\u0431\u0440\u0430\u043d\u0438\u044f \u043f\u0440\u043e\u0434\u0443\u043a\u0442"],"Show product quick view icon in the selected product.":["\u041f\u043e\u043a\u0430\u0436\u0438 \u0438\u043a\u043e\u043d\u0430\u0442\u0430 \u0437\u0430 \u0431\u044a\u0440\u0437 \u043f\u0440\u0435\u0433\u043b\u0435\u0434 \u043d\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430 \u0432 \u0438\u0437\u0431\u0440\u0430\u043d\u0438\u044f \u043f\u0440\u043e\u0434\u0443\u043a\u0442"],"Quantity field on item":["\u041f\u043e\u043b\u0435 \u0437\u0430 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043d\u0430 \u0430\u0440\u0442\u0438\u043a\u0443\u043b\u0430"],"Show quantity field on item.":["\u041f\u043e\u043a\u0430\u0436\u0438 \u043f\u043e\u043b\u0435\u0442\u043e \u0437\u0430 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043d\u0430 \u0430\u0440\u0442\u0438\u043a\u0443\u043b\u0430"],"Show plus icon":["\u041f\u043e\u043a\u0430\u0437\u0432\u0430\u043d\u0435 \u043d\u0430 \u0438\u043a\u043e\u043d\u0430 \u043f\u043b\u044e\u0441"],"Show plus icon between items.":["\u041f\u043e\u043a\u0430\u0437\u0432\u0430\u043d\u0435 \u043d\u0430 \u0438\u043a\u043e\u043d\u0430 \u043f\u043b\u044e\u0441 \u043c\u0435\u0436\u0434\u0443 \u0435\u043b\u0435\u043c\u0435\u043d\u0442\u0438\u0442\u0435"],"Calculate bundle price in frontend":["\u0418\u0437\u0447\u0438\u0441\u043b\u0438 \u0446\u0435\u043d\u0430\u0442\u0430 \u043d\u0430 \u043f\u0430\u043a\u0435\u0442\u0430 \u0432\u044a\u0432 \u0444\u0440\u043e\u043d\u0442\u0435\u043d\u0434\u0430"],"It can enhance compatibility with discount plugin, but may lead to memory issues if the bundle contains many items. It is useful for dynamic price bundles. Only enable it if necessary.":["\u041c\u043e\u0436\u0435 \u0434\u0430 \u043f\u043e\u0434\u043e\u0431\u0440\u0438 \u0441\u044a\u0432\u043c\u0435\u0441\u0442\u0438\u043c\u043e\u0441\u0442\u0442\u0430 \u0441 \u043f\u043b\u044a\u0433\u0438\u043d\u0430 \u0437\u0430 \u043e\u0442\u0441\u0442\u044a\u043f\u043a\u0438, \u043d\u043e \u043c\u043e\u0436\u0435 \u0434\u0430 \u0434\u043e\u0432\u0435\u0434\u0435 \u0434\u043e \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0438 \u0441 \u043f\u0430\u043c\u0435\u0442\u0442\u0430, \u0430\u043a\u043e \u043f\u0430\u043a\u0435\u0442\u044a\u0442 \u0441\u044a\u0434\u044a\u0440\u0436\u0430 \u043c\u043d\u043e\u0433\u043e \u0430\u0440\u0442\u0438\u043a\u0443\u043b\u0438. \u041f\u043e\u043b\u0435\u0437\u043d\u043e \u0435 \u0437\u0430 \u043f\u0430\u043a\u0435\u0442\u0438 \u0441 \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u043d\u0430 \u0446\u0435\u043d\u0430. \u0410\u043a\u0442\u0438\u0432\u0438\u0440\u0430\u0439\u0442\u0435 \u0433\u043e \u0441\u0430\u043c\u043e \u0430\u043a\u043e \u0435 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e."],"Theme":["\u0422\u0435\u043c\u0430"],"Grid 1":["\u0420\u0435\u0448\u0435\u0442\u043a\u0430 1"],"Grid 2":["\u0420\u0435\u0448\u0435\u0442\u043a\u0430 2"],"List 1":["\u0421\u043f\u0438\u0441\u044a\u043a 1"],"List 2":["\u0421\u043f\u0438\u0441\u044a\u043a 2"],"Size":["\u0420\u0430\u0437\u043c\u0435\u0440"],"Small":["\u041c\u0430\u043b\u044a\u043a"],"Medium":["\u0421\u0440\u0435\u0434\u0435\u043d"],"Large":["\u0413\u043e\u043b\u044f\u043c"],"Optional item mode":["\u0420\u0435\u0436\u0438\u043c \u043d\u0430 \u043e\u043f\u0446\u0438\u043e\u043d\u0430\u043b\u0435\u043d \u0435\u043b\u0435\u043c\u0435\u043d\u0442"],"Checkbox":["\u041a\u0432\u0430\u0434\u0440\u0430\u0442\u0447\u0435 \u0437\u0430 \u043e\u0442\u043c\u0435\u0442\u043a\u0430"],"Delete button":["\u0411\u0443\u0442\u043e\u043d \u0437\u0430 \u0438\u0437\u0442\u0440\u0438\u0432\u0430\u043d\u0435"],"Product bundle price on shop page":["\u0426\u0435\u043d\u0430 \u043d\u0430 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0442\u0430 \u043d\u0430 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430\u0442\u0430 \u043d\u0430 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0430"],"Total price":["\u041e\u0431\u0449\u0430 \u0446\u0435\u043d\u0430"],"From total price":["\u041e\u0442 \u043e\u0431\u0449\u0430\u0442\u0430 \u0446\u0435\u043d\u0430"],"From min price":["\u041e\u0442 \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u043d\u0430\u0442\u0430 \u0446\u0435\u043d\u0430"],"Set how to show the product bundle price on the shop page.":["\u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u0442\u0435 \u043a\u0430\u043a \u0434\u0430 \u043f\u043e\u043a\u0430\u0437\u0432\u0430\u0442\u0435 \u0446\u0435\u043d\u0430\u0442\u0430 \u043d\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u043e\u0432\u0438\u044f \u043f\u0430\u043a\u0435\u0442 \u043d\u0430 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430\u0442\u0430 \u043d\u0430 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0430."],"Item price":["\u0426\u0435\u043d\u0430 \u043d\u0430 \u0430\u0440\u0442\u0438\u043a\u0443\u043b\u0430"],"Product price":["\u0426\u0435\u043d\u0430 \u043d\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430"],"Product subtotal":["\u041c\u0435\u0436\u0434\u0438\u043d\u043d\u0430 \u0441\u0443\u043c\u0430 \u043d\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430"],"Set how to show the product price in item.":["\u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u0442\u0435 \u043a\u0430\u043a \u0434\u0430 \u043f\u043e\u043a\u0430\u0437\u0432\u0430\u0442\u0435 \u0446\u0435\u043d\u0430\u0442\u0430 \u043d\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430 \u0432 \u0430\u0440\u0442\u0438\u043a\u0443\u043b\u0430"],"Product list price":["\u0426\u0435\u043d\u0430 \u043d\u0430 \u0441\u043f\u0438\u0441\u044a\u043a\u0430 \u0441 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438"],"Set how to show the product price in product list.":["\u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u0442\u0435 \u043a\u0430\u043a \u0434\u0430 \u043f\u043e\u043a\u0430\u0437\u0432\u0430\u0442\u0435 \u0446\u0435\u043d\u0430\u0442\u0430 \u043d\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430 \u0432 \u0441\u043f\u0438\u0441\u044a\u043a\u0430 \u0441 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438."],"Link to product":["\u0412\u0440\u044a\u0437\u043a\u0430 \u043a\u044a\u043c \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430"],"New tab":["\u041d\u043e\u0432 \u0440\u0430\u0437\u0434\u0435\u043b"],"No link":["\u041d\u044f\u043c\u0430 \u0432\u0440\u044a\u0437\u043a\u0430"],"Show the product change popup":["\u041f\u043e\u043a\u0430\u0436\u0438 \u0438\u0437\u0441\u043a\u0430\u0447\u0430\u0449 \u043f\u0440\u043e\u0437\u043e\u0440\u0435\u0446 \u0437\u0430 \u043f\u0440\u043e\u043c\u044f\u043d\u0430 \u043d\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430"],"Coupon apply method":["\u041c\u0435\u0442\u043e\u0434 \u0437\u0430 \u043f\u0440\u0438\u043b\u0430\u0433\u0430\u043d\u0435 \u043d\u0430 \u043a\u0443\u043f\u043e\u043d"],"Both of bundle and bundle items":["\u0418 \u0437\u0430 \u043f\u0430\u043a\u0435\u0442\u0430, \u0438 \u0437\u0430 \u0430\u0440\u0442\u0438\u043a\u0443\u043b\u0438\u0442\u0435 \u0432 \u043f\u0430\u043a\u0435\u0442\u0430"],"On bundle":["\u0412\u044a\u0440\u0445\u0443 \u043f\u0430\u043a\u0435\u0442\u0430"],"On bundle items":["\u0412\u044a\u0440\u0445\u0443 \u0430\u0440\u0442\u0438\u043a\u0443\u043b\u0438\u0442\u0435 \u0432 \u043f\u0430\u043a\u0435\u0442\u0430"],"None of bundle and bundle items":["\u041d\u0438\u0442\u043e \u0437\u0430 \u043f\u0430\u043a\u0435\u0442\u0430, \u043d\u0438\u0442\u043e \u0437\u0430 \u0430\u0440\u0442\u0438\u043a\u0443\u043b\u0438\u0442\u0435 \u0432 \u043f\u0430\u043a\u0435\u0442\u0430"],"Product based coupons apply method. Can apply on \"bundle\", \"bundle items\", \"both\" or \"none\".":["\u041c\u0435\u0442\u043e\u0434 \u0437\u0430 \u043f\u0440\u0438\u043b\u0430\u0433\u0430\u043d\u0435 \u043d\u0430 \u043a\u0443\u043f\u043e\u043d\u0438, \u0431\u0430\u0437\u0438\u0440\u0430\u043d\u0438 \u043d\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438. \u041c\u043e\u0436\u0435 \u0434\u0430 \u0441\u0435 \u043f\u0440\u0438\u043b\u0430\u0433\u0430 \u0432\u044a\u0440\u0445\u0443 \"\u043f\u0430\u043a\u0435\u0442\", \"\u0430\u0440\u0442\u0438\u043a\u0443\u043b\u0438 \u0432 \u043f\u0430\u043a\u0435\u0442\", \"\u0438 \u0434\u0432\u0435\u0442\u0435\" \u0438\u043b\u0438 \"\u043d\u0438\u0449\u043e\"."],"Cart contents count":["\u0411\u0440\u043e\u0439 \u043d\u0430 \u0441\u044a\u0434\u044a\u0440\u0436\u0430\u043d\u0438\u0435\u0442\u043e \u0432 \u043a\u043e\u043b\u0438\u0447\u043a\u0430\u0442\u0430"],"Bundle items":["\u0410\u0440\u0442\u0438\u043a\u0443\u043b\u0438 \u0432 \u043f\u0430\u043a\u0435\u0442"],"How to count bundle products in the cart? Count both of \"bundle and its items\" or \"only bundle\" or \"only bundle items\".":["\u041a\u0430\u043a \u0434\u0430 \u0431\u0440\u043e\u0438\u043c \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0442\u0435 \u0432 \u043f\u0430\u043a\u0435\u0442 \u0432 \u043a\u043e\u043b\u0438\u0447\u043a\u0430\u0442\u0430? \u0414\u0430 \u0431\u0440\u043e\u0438\u043c \u0438 \"\u043f\u0430\u043a\u0435\u0442\u0430 \u0438 \u043d\u0435\u0433\u043e\u0432\u0438\u0442\u0435 \u0430\u0440\u0442\u0438\u043a\u0443\u043b\u0438\", \u0438\u043b\u0438 \"\u0441\u0430\u043c\u043e \u043f\u0430\u043a\u0435\u0442\u0430\", \u0438\u043b\u0438 \"\u0441\u0430\u043c\u043e \u0430\u0440\u0442\u0438\u043a\u0443\u043b\u0438\u0442\u0435 \u0432 \u043f\u0430\u043a\u0435\u0442\u0430\"."],"Product price selector":["\u0418\u0437\u0431\u043e\u0440 \u043d\u0430 \u0446\u0435\u043d\u0430 \u043d\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430"],"Add to cart button selector":["\u0421\u0435\u043b\u0435\u043a\u0442\u043e\u0440 \u043d\u0430 \u0431\u0443\u0442\u043e\u043d\u0430 \u0414\u043e\u0431\u0430\u0432\u0438 \u0432 \u043a\u043e\u043b\u0438\u0447\u043a\u0430\u0442\u0430"],"Change product popup":["\u0418\u0437\u0441\u043a\u0430\u0447\u0430\u0449 \u043f\u0440\u043e\u0437\u043e\u0440\u0435\u0446 \u0437\u0430 \u043f\u0440\u043e\u043c\u044f\u043d\u0430 \u043d\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430"],"Disable popup":["\u0418\u0437\u043a\u043b\u044e\u0447\u0432\u0430\u043d\u0435 \u043d\u0430 \u0438\u0437\u0441\u043a\u0430\u0447\u0430\u0449\u0438\u044f"],"Disable popup for items that have only one product.":["\u0414\u0435\u0430\u043a\u0442\u0438\u0432\u0438\u0440\u0430\u043d\u0435 \u043d\u0430 \u0438\u0437\u0441\u043a\u0430\u0447\u0430\u0449\u0438\u044f \u043f\u0440\u043e\u0437\u043e\u0440\u0435\u0446 \u0437\u0430 \u0430\u0440\u0442\u0438\u043a\u0443\u043b\u0438 \u0441 \u0441\u0430\u043c\u043e \u0435\u0434\u0438\u043d \u043f\u0440\u043e\u0434\u0443\u043a\u0442."],"Popup Variable \u2018Show Options\u2019 Button":["\u0411\u0443\u0442\u043e\u043d \u201e\u041f\u043e\u043a\u0430\u0436\u0438 \u043e\u043f\u0446\u0438\u0438\u201c \u0432 \u0438\u0437\u0441\u043a\u0430\u0447\u0430\u0449\u0438\u044f \u043f\u0440\u043e\u0437\u043e\u0440\u0435\u0446 \u0437\u0430 \u043f\u0440\u043e\u043c\u0435\u043d\u043b\u0438\u0432\u0438 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438"],"Show or hide the \u201cShow Options\u201d button for variable products inside the popup.":["\u041f\u043e\u043a\u0430\u0437\u0432\u0430\u043d\u0435 \u0438\u043b\u0438 \u0441\u043a\u0440\u0438\u0432\u0430\u043d\u0435 \u043d\u0430 \u0431\u0443\u0442\u043e\u043d\u0430 \u201e\u041f\u043e\u043a\u0430\u0436\u0438 \u043e\u043f\u0446\u0438\u0438\u201c \u0437\u0430 \u043f\u0440\u043e\u043c\u0435\u043d\u043b\u0438\u0432\u0438 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438 \u0432 \u0438\u0437\u0441\u043a\u0430\u0447\u0430\u0449\u0438\u044f \u043f\u0440\u043e\u0437\u043e\u0440\u0435\u0446"],"Show stock":["\u041f\u043e\u043a\u0430\u0436\u0438 \u043d\u0430\u043b\u0438\u0447\u043d\u043e\u0441\u0442"],"Show product Stock availability in popup.":["\u041f\u043e\u043a\u0430\u0437\u0432\u0430\u043d\u0435 \u043d\u0430 \u043d\u0430\u043b\u0438\u0447\u043d\u043e\u0441\u0442\u0442\u0430 \u043d\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430 \u0432 \u0438\u0437\u0441\u043a\u0430\u0447\u0430\u0449 \u043f\u0440\u043e\u0437\u043e\u0440\u0435\u0446."],"Show rating":["\u041f\u043e\u043a\u0430\u0436\u0438 \u043e\u0446\u0435\u043d\u043a\u0430"],"Show product rating in popup.":["\u041f\u043e\u043a\u0430\u0437\u0432\u0430\u043d\u0435 \u043d\u0430 \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u0430 \u043d\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430 \u0432 \u0438\u0437\u0441\u043a\u0430\u0447\u0430\u0449 \u043f\u0440\u043e\u0437\u043e\u0440\u0435\u0446."],"Show popup quick view":["\u041f\u043e\u043a\u0430\u0436\u0438 \u0431\u044a\u0440\u0437 \u043f\u0440\u0435\u0433\u043b\u0435\u0434 \u0432 \u0438\u0437\u0441\u043a\u0430\u0447\u0430\u0449 \u043f\u0440\u043e\u0437\u043e\u0440\u0435\u0446"],"Show product quick view icon in popup.":["\u041f\u043e\u043a\u0430\u0436\u0438 \u0438\u043a\u043e\u043d\u0430\u0442\u0430 \u0437\u0430 \u0431\u044a\u0440\u0437 \u043f\u0440\u0435\u0433\u043b\u0435\u0434 \u043d\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430 \u0432 \u0438\u0437\u0441\u043a\u0430\u0447\u0430\u0449 \u043f\u0440\u043e\u0437\u043e\u0440\u0435\u0446"],"Show search field in popup":["\u041f\u043e\u043a\u0430\u0437\u0432\u0430\u043d\u0435 \u043d\u0430 \u043f\u043e\u043b\u0435\u0442\u043e \u0437\u0430 \u0442\u044a\u0440\u0441\u0435\u043d\u0435 \u0432 \u0438\u0437\u0441\u043a\u0430\u0447\u0430\u0449\u0438\u044f \u043f\u0440\u043e\u0437\u043e\u0440\u0435\u0446"],"This option allows you to show or hide the product search field in the popup window.":["\u0422\u0430\u0437\u0438 \u043e\u043f\u0446\u0438\u044f \u0432\u0438 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0432\u0430 \u0434\u0430 \u043f\u043e\u043a\u0430\u0436\u0435\u0442\u0435 \u0438\u043b\u0438 \u0441\u043a\u0440\u0438\u0435\u0442\u0435 \u043f\u043e\u043b\u0435\u0442\u043e \u0437\u0430 \u0442\u044a\u0440\u0441\u0435\u043d\u0435 \u043d\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438 \u0432 \u0438\u0437\u0441\u043a\u0430\u0447\u0430\u0449\u0438\u044f \u043f\u0440\u043e\u0437\u043e\u0440\u0435\u0446."],"Show Variable Dropdown in Popup":["\u041f\u0430\u0434\u0430\u0449\u043e \u043c\u0435\u043d\u044e \u0437\u0430 \u0432\u0430\u0440\u0438\u0430\u0446\u0438\u0438 \u0432 \u0438\u0437\u0441\u043a\u0430\u0447\u0430\u0449 \u043f\u0440\u043e\u0437\u043e\u0440\u0435\u0446"],"Enable this option to display the dropdown menu for variable products in the popup.":["\u0410\u043a\u0442\u0438\u0432\u0438\u0440\u0430\u0439\u0442\u0435 \u0442\u0430\u0437\u0438 \u043e\u043f\u0446\u0438\u044f, \u0437\u0430 \u0434\u0430 \u0441\u0435 \u043f\u043e\u043a\u0430\u0437\u0432\u0430 \u043f\u0430\u0434\u0430\u0449\u043e\u0442\u043e \u043c\u0435\u043d\u044e \u0437\u0430 \u0432\u0430\u0440\u0438\u0430\u0446\u0438\u0438 \u0432 \u0438\u0437\u0441\u043a\u0430\u0447\u0430\u0449\u0438\u044f \u043f\u0440\u043e\u0437\u043e\u0440\u0435\u0446."],"Click on product in pop-up":["\u0429\u0440\u0430\u043a\u043d\u0435\u0442\u0435 \u0432\u044a\u0440\u0445\u0443 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430 \u0432 \u0438\u0437\u0441\u043a\u0430\u0447\u0430\u0449\u0438\u044f \u043f\u0440\u043e\u0437\u043e\u0440\u0435\u0446"],"Product selection":["\u0418\u0437\u0431\u043e\u0440 \u043d\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0442"],"Show product details":["\u041f\u043e\u043a\u0430\u0437\u0432\u0430\u043d\u0435 \u043d\u0430 \u0434\u0435\u0442\u0430\u0439\u043b\u0438\u0442\u0435 \u0437\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430"],"Number of products per page":["\u0411\u0440\u043e\u0439 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438 \u043d\u0430 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430"],"Set how many products are displayed per page in the popup.":["\u0417\u0430\u0434\u0430\u0439\u0442\u0435 \u043a\u043e\u043b\u043a\u043e \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430 \u0441\u0435 \u043f\u043e\u043a\u0430\u0437\u0432\u0430\u0442 \u043d\u0430 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430 \u0432 \u0438\u0437\u0441\u043a\u0430\u0447\u0430\u0449\u0438\u044f \u043f\u0440\u043e\u0437\u043e\u0440\u0435\u0446."],"Styles":["\u0421\u0442\u0438\u043b\u043e\u0432\u0435"],"There was an error on applying review.":["\u0412\u044a\u0437\u043d\u0438\u043a\u043d\u0430 \u0433\u0440\u0435\u0448\u043a\u0430 \u043f\u0440\u0438 \u043f\u0440\u0438\u043b\u0430\u0433\u0430\u043d\u0435\u0442\u043e \u043d\u0430 \u0440\u0435\u0432\u044e\u0442\u043e."],"There was an error on getting settings.":["\u0412\u044a\u0437\u043d\u0438\u043a\u043d\u0430 \u0433\u0440\u0435\u0448\u043a\u0430 \u043f\u0440\u0438 \u0438\u0437\u0432\u043b\u0438\u0447\u0430\u043d\u0435 \u043d\u0430 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438\u0442\u0435."],"Data is required.":["\u041d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u0438 \u0441\u0430 \u0434\u0430\u043d\u043d\u0438"],"There was an error on saving settings.":["\u0412\u044a\u0437\u043d\u0438\u043a\u043d\u0430 \u0433\u0440\u0435\u0448\u043a\u0430 \u043f\u0440\u0438 \u0437\u0430\u043f\u0430\u0437\u0432\u0430\u043d\u0435 \u043d\u0430 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438\u0442\u0435."],"We hope you're enjoying %1$s! %3$s Could you please do us a BIG favor and give it a %2$s to help us spread the word and boost our motivation?%4$s %5$sShare your feature requests%6$s with the review, We always check them and try our best.":["\u041d\u0430\u0434\u044f\u0432\u0430\u043c\u0435 \u0441\u0435, \u0447\u0435 \u0432\u0438 \u0445\u0430\u0440\u0435\u0441\u0432\u0430 %1$s! \u041c\u043e\u0436\u0435\u0442\u0435 \u043b\u0438, \u043c\u043e\u043b\u044f, \u0434\u0430 \u043d\u0438 \u043d\u0430\u043f\u0440\u0430\u0432\u0438\u0442\u0435 \u0413\u041e\u041b\u042f\u041c\u0410 \u0443\u0441\u043b\u0443\u0433\u0430 \u0438 \u0434\u0430 \u043d\u0438 \u0434\u0430\u0434\u0435\u0442\u0435 %2$s, \u0437\u0430 \u0434\u0430 \u043d\u0438 \u043f\u043e\u043c\u043e\u0433\u043d\u0435\u0442\u0435 \u0434\u0430 \u0440\u0430\u0437\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0438\u043c \u0434\u0443\u043c\u0430\u0442\u0430 \u0438 \u0434\u0430 \u043f\u043e\u0432\u0438\u0448\u0438\u043c \u043c\u043e\u0442\u0438\u0432\u0430\u0446\u0438\u044f\u0442\u0430 \u0441\u0438? \u0421\u043f\u043e\u0434\u0435\u043b\u0435\u0442\u0435 \u0432\u0430\u0448\u0438\u0442\u0435 \u0438\u0441\u043a\u0430\u043d\u0438\u044f \u0437\u0430 \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u0441 \u0440\u0435\u0446\u0435\u043d\u0437\u0438\u044f\u0442\u0430, \u0412\u0438\u043d\u0430\u0433\u0438 \u0433\u0438 \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0432\u0430\u043c\u0435 \u0438 \u0441\u0435 \u0441\u0442\u0430\u0440\u0430\u0435\u043c \u0434\u0430 \u043d\u0430\u043f\u0440\u0430\u0432\u0438\u043c \u043d\u0430\u0439-\u0434\u043e\u0431\u0440\u043e\u0442\u043e."],"OK, you deserve it!":["\u0414\u043e\u0431\u0440\u0435, \u0437\u0430\u0441\u043b\u0443\u0436\u0430\u0432\u0430\u0442\u0435 \u0433\u043e!"],"I already did":["\u0412\u0435\u0447\u0435 \u0433\u043e \u043d\u0430\u043f\u0440\u0430\u0432\u0438\u0445"],"I need help":["\u0418\u043c\u0430\u043c \u043d\u0443\u0436\u0434\u0430 \u043e\u0442 \u043f\u043e\u043c\u043e\u0449"],"Never show again":["\u041d\u0438\u043a\u043e\u0433\u0430 \u043f\u043e\u0432\u0435\u0447\u0435 \u0434\u0430 \u043d\u0435 \u0441\u0435 \u043f\u043e\u043a\u0430\u0437\u0432\u0430"]}}}