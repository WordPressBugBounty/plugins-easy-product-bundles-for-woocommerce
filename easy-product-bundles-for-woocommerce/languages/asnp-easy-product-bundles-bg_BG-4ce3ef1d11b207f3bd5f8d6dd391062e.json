35\u043d\u0430."],"Item %d":["\u0415\u043b\u0435\u043c\u0435\u043d\u0442 %d"],"Duplicate: Pro version":["\u0414\u0443\u0431\u043b\u0438\u043a\u0430\u0442: \u041f\u0440\u043e \u0432\u0435\u0440\u0441\u0438\u044f"],"Duplicate":["\u0414\u0443\u0431\u043b\u0438\u043a\u0430\u0442"],"Trash":["\u041a\u043e\u0448\u0447\u0435"],"General":["\u041e\u0431\u0449"],"Display":["\u041f\u043e\u043a\u0430\u0437\u0432\u0430"],"Default Image":["\u0418\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u043f\u043e \u043f\u043e\u0434\u0440\u0430\u0437\u0431\u0438\u0440\u0430\u043d\u0435"],"No image chosen":["\u041d\u044f\u043c\u0430 \u0438\u0437\u0431\u0440\u0430\u043d\u043e \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435"],"Upload Image":["\u041a\u0430\u0447\u0438 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435"],"Set an image for empty item.":["\u0417\u0430\u0434\u0430\u0439\u0442\u0435 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u0437\u0430 \u043f\u0440\u0430\u0437\u0435\u043d \u0435\u043b\u0435\u043c\u0435\u043d\u0442."],"Please enable fixed price first.":["\u041c\u043e\u043b\u044f, \u043f\u044a\u0440\u0432\u043e \u0430\u043a\u0442\u0438\u0432\u0438\u0440\u0430\u0439\u0442\u0435 \u0444\u0438\u043a\u0441\u0438\u0440\u0430\u043d\u0430\u0442\u0430 \u0446\u0435\u043d\u0430."],"Article":["\u0421\u0442\u0430\u0442\u0438\u044f"],"Quick Tutorial":["\u041a\u0440\u0430\u0442\u043a\u043e \u0440\u044a\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e"],"Need help?":["\u041d\u0443\u0436\u0434\u0430\u0435\u0442\u0435 \u0441\u0435 \u043e\u0442 \u043f\u043e\u043c\u043e\u0449?"],"GO PRO":["\u041f\u0440\u0435\u043c\u043d\u0435\u0442\u0435 \u043a\u044a\u043c PRO"],"Individual theme":["\u0418\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u043d\u0430 \u0442\u0435\u043c\u0430"],"If checked, disable auto calculate price and use product price as bundle price.":["\u0410\u043a\u043e \u0435 \u043e\u0442\u043c\u0435\u0442\u043d\