 the default product field and is not optional.":["\u0410\u043a\u0442\u0443\u0430\u043b\u0438\u0437\u0438\u0440\u0430\u043d\u0435 \u043d\u0430 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e\u0442\u043e \u043d\u0430\u043b\u0438\u0447\u043d\u043e\u0441\u0442 \u043d\u0430 \u043f\u0430\u043a\u0435\u0442\u0430 \u0432\u044a\u0437 \u043e\u0441\u043d\u043e\u0432\u0430 \u043d\u0430 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e\u0442\u043e \u043d\u0430\u043b\u0438\u0447\u043d\u043e\u0441\u0442 \u043d\u0430 \u0434\u044a\u0449\u0435\u0440\u043d\u0438\u0442\u0435 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438. \u0417\u0430\u0431\u0435\u043b\u0435\u0436\u043a\u0430: \u0422\u0430\u0437\u0438 \u0444\u0443\u043d\u043a\u0446\u0438\u044f \u0440\u0430\u0431\u043e\u0442\u0438 \u0441\u0430\u043c\u043e \u043a\u043e\u0433\u0430\u0442\u043e \u0432\u0441\u0435\u043a\u0438 \u0435\u043b\u0435\u043c\u0435\u043d\u0442 \u0438\u043c\u0430 \u0442\u043e\u0447\u043d\u043e \u0435\u0434\u0438\u043d \u043f\u0440\u043e\u0434\u0443\u043a\u0442, \u043a\u043e\u0439\u0442\u043e \u0435 \u0434\u043e\u0431\u0430\u0432\u0435\u043d \u0432 \u043f\u043e\u043b\u0435\u0442\u043e \u0437\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0442 \u043f\u043e \u043f\u043e\u0434\u0440\u0430\u0437\u0431\u0438\u0440\u0430\u043d\u0435 \u0438 \u043d\u0435 \u0435 \u043f\u043e \u0438\u0437\u0431\u043e\u0440."],"Hide products price":["\u0421\u043a\u0440\u0438\u0439 \u0446\u0435\u043d\u0430\u0442\u0430 \u043d\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0442\u0435"],"No":["\u041d\u0435"],"Yes":["\u0414\u0430"],"Only regular price":["\u0421\u0430\u043c\u043e \u0440\u0435\u0434\u043e\u0432\u043d\u0430 \u0446\u0435\u043d\u0430"],"Shipping fee":["\u0422\u0430\u043a\u0441\u0430 \u0437\u0430 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0430"],"Apply to the whole bundle":["\u041f\u0440\u0438\u043b\u043e\u0436\u0438 \u0432\u044a\u0440\u0445\u0443 \u0446\u0435\u043b\u0438\u044f \u043f\u0430\u043a\u0435\u0442"],"Apply to the parent product":["\u041f\u0440\u0438\u043b\u043e\u0436\u0438 \u043a\u044a\u043c \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u0441\u043a\u0438\u044f \u043f\u0440\u043e\u0434\u0443\u043a\u0442"],"Apply to each bundle item":["\u041f\u0440\u0438\u043b\u043e\u0436\u0438 \u043a\u044a\u043c \u0432\u0441\u0435\u043a\u0438 \u0435\u043b\u0435\u043c\u0435\u043d\u0442 \u043e\u0442 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0442\u0430"],"Min items quantity":["\u041c\u0438\u043d\u0438\u043c\u0430\u043b\u043d\u043e \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0430\u0440\u0442\u0438\u043a\u0443\u043b\u0438"],"Set the minimum total quantity of bundled items.":["\u0417\u0430\u0434\u0430\u0439\u0442\u0435 \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u043d\u043e\u0442\u043e \u043e\u0431\u0449\u043e \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043d\u0430 \u043e\u043f\u0430\u043a\u043e\u0432\u0430\u043d\u0438 \u0430\u0440\u0442\u0438\u043a\u0443\u043b\u0438."],"Max items quantity":["\u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u043d\u043e \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0430\u0440\u0442\u0438\u043a\u0443\u043b\u0438"],"Set the maximum total quantity of bundled items.":["\u0417\u0430\u0434\u0430\u0439\u0442\u0435 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u043d\u043e\u0442\u043e \u043e\u0431\u0449\u043e \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043d\u0430 \u043e\u043f\u0430\u043a\u043e\u0432\u0430\u043d\u0438 \u0430\u0440\u0442\u0438\u043a\u0443\u043b\u0438."],"Custom display price":["\u041f\u043e\u043a\u0430\u0436\u0438 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u0430\u043d\u0430 \u0446\u0435\u043d\u0430"],"Product display price in frontend. E.g: From 10$ To 20$":["\u041f\u043e\u043a\u0430\u0437\u0432\u0430\u043d\u0435 \u043d\u0430 \u0446\u0435\u043d\u0430\u0442\u0430 \u043d\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430 \u0432\u044a\u0432 \u0444\u0440\u043e\u043d\u0442\u0435\u043d\u0434\u0430. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440: \u043e\u0442 10$ \u0434\u043e 20$"],"A title for the bundle product that will be shown on top of bundle items.":["\u0417\u0430\u0433\u043b\u0430\u0432\u0438\u0435 \u0437\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430 \u043e\u0442 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0442\u0430, \u043a\u043e\u0435\u0442\u043e \u0449\u0435 \u0441\u0435 \u043f\u043e\u043a\u0430\u0437\u0432\u0430 \u0432\u044a\u0440\u0445\u0443 \u0435\u043b\u0435\u043c\u0435\u043d\u0442\u0438\u0442\u0435 \u043e\u0442 \u043f\u0430\u043a\u0435\u0442\u0430."],"Bundle description":["\u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u043d\u0430 \u043f\u0430\u043a\u0435\u0442\u0430"],"Create a description for product bundle.":["\u0421\u044a\u0437\u0434\u0430\u0439\u0442\u0435 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u0437\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u043e\u0432\u0430 \u043f\u0430\u043a\u0435\u0442."],"Bundle button label (shop page)":["\u0415\u0442\u0438\u043a\u0435\u0442 \u043d\u0430 \u0431\u0443\u0442\u043e\u043d\u0430 \u0437\u0430 \u043f\u0430\u043a\u0435\u0442 (\u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430 \u043d\u0430 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0430)"],"Change the button label shown for bundle products in the shop page.":["\u041f\u0440\u043e\u043c\u0435\u043d\u0435\u0442\u0435 \u0435\u0442\u0438\u043a\u0435\u0442\u0430 \u043d\u0430 \u0431\u0443\u0442\u043e\u043d\u0430, \u043f\u043e\u043a\u0430\u0437\u0430\u043d \u0437\u0430 \u043f\u0430\u043a\u0435\u0442\u043d\u0438 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438 \u0432 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430\u0442\u0430 \u043d\u0430 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0430."],"Total discount":["\u041e\u0431\u0449\u0430 \u043e\u0442\u0441\u0442\u044a\u043f\u043a\u0430"],"Set a total discount for the bundle total price based on percentage or price.":["\u0417\u0430\u0434\u0430\u0439\u0442\u0435 \u043e\u0431\u0449\u0430 \u043e\u0442\u0441\u0442\u044a\u043f\u043a\u0430 \u0437\u0430 \u043e\u0431\u0449\u0430\u0442\u0430 \u0446\u0435\u043d\u0430 \u043d\u0430 \u043f\u0430\u043a\u0435\u0442\u0430 \u0432\u044a\u0437 \u043e\u0441\u043d\u043e\u0432\u0430 \u043d\u0430 \u043f\u0440\u043e\u0446\u0435\u043d\u0442 \u0438\u043b\u0438 \u0441\u0443\u043c\u0430."],"Add Item":["\u0414\u043e\u0431\u0430\u0432\u044f\u043d\u0435 \u043d\u0430 \u0435\u043b\u0435\u043c\u0435\u043d\u0442"]}}}