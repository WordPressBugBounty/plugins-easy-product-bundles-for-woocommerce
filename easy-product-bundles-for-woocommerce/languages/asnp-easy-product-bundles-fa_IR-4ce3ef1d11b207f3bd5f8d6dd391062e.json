eature works only when each item has exactly one product, which is added to the default product field and is not optional.":["\u0628\u0647\u200c\u0631\u0648\u0632\u0631\u0633\u0627\u0646\u06cc \u0645\u0642\u062f\u0627\u0631 \u0645\u0648\u062c\u0648\u062f\u06cc \u0628\u0633\u062a\u0647 \u0628\u0631 \u0627\u0633\u0627\u0633 \u0645\u0642\u062f\u0627\u0631 \u0645\u0648\u062c\u0648\u062f\u06cc \u0645\u062d\u0635\u0648\u0644\u0627\u062a \u0632\u06cc\u0631\u0645\u062c\u0645\u0648\u0639\u0647. \u062a\u0648\u062c\u0647: \u0627\u06cc\u0646 \u0642\u0627\u0628\u0644\u06cc\u062a \u0641\u0642\u0637 \u062f\u0631 \u0635\u0648\u0631\u062a\u06cc \u06a9\u0627\u0631 \u0645\u06cc\u200c\u06a9\u0646\u062f \u06a9\u0647 \u0647\u0631 \u0645\u0648\u0631\u062f \u062f\u0642\u06cc\u0642\u0627\u064b \u0634\u0627\u0645\u0644 \u06cc\u06a9 \u0645\u062d\u0635\u0648\u0644 \u0628\u0627\u0634\u062f \u06a9\u0647 \u0628\u0647 \u0641\u06cc\u0644\u062f \u0645\u062d\u0635\u0648\u0644 \u067e\u06cc\u0634\u200c\u0641\u0631\u0636 \u0627\u0636\u0627\u0641\u0647 \u0634\u062f\u0647 \u0648 \u0627\u062e\u062a\u06cc\u0627\u0631\u06cc \u0646\u06cc\u0633\u062a."],"Hide products price":["\u067e\u0646\u0647\u0627\u0646 \u06a9\u0631\u062f\u0646 \u0642\u06cc\u0645\u062a \u0645\u062d\u0635\u0648\u0644\u0627\u062a"],"No":["\u062e\u06cc\u0631"],"Yes":["\u0628\u0644\u0647"],"Only regular price":["\u0641\u0642\u0637 \u0642\u06cc\u0645\u062a \u0639\u0627\u062f\u06cc"],"Shipping fee":["\u0647\u0632\u06cc\u0646\u0647 \u062d\u0645\u0644 \u0648 \u0646\u0642\u0644"],"Apply to the whole bundle":["\u0628\u0631\u0627\u06cc \u06a9\u0644 \u0628\u0633\u062a\u0647\u200c\u0628\u0646\u062f\u06cc \u0627\u0639\u0645\u0627\u0644 \u0634\u0648\u062f"],"Apply to the parent product":["\u0627\u0639\u0645\u0627\u0644 \u0631\u0648\u06cc \u0645\u062d\u0635\u0648\u0644 \u0648\u0627\u0644\u062f"],"Apply to each bundle item":["\u0628\u0631\u0627\u06cc \u0647\u0631 \u0645\u0648\u0631\u062f \u0628\u0633\u062a\u0647\u200c\u0628\u0646\u062f\u06cc \u0627\u0639\u