948\u0902"],"Active Installations":["\u0938\u0915\u094d\u0930\u093f\u092f \u0907\u0902\u0938\u094d\u091f\u0949\u0932\u0947\u0936\u0928"],"Free Version":["\u0928\u093f\u0903\u0936\u0941\u0932\u094d\u0915 \u0938\u0902\u0938\u094d\u0915\u0930\u0923"],"Bundle":["\u092c\u0902\u0921\u0932"],"Item View":["\u0906\u0907\u091f\u092e \u0926\u0943\u0936\u094d\u092f"],"Show description(on hover)":["\u0935\u093f\u0935\u0930\u0923 \u0926\u093f\u0916\u093e\u090f\u0902 (\u0939\u094b\u0935\u0930 \u092a\u0930)"],"Show product description when mouse hover over it.":["\u091c\u092c \u092e\u093e\u0909\u0938 \u0907\u0938\u0915\u0947 \u090a\u092a\u0930 \u0939\u094b\u0935\u0930 \u0915\u0930\u0924\u093e \u0939\u0948 \u0924\u094b \u0909\u0924\u094d\u092a\u093e\u0926 \u0915\u093e \u0935\u093f\u0935\u0930\u0923 \u0926\u093f\u0916\u093e\u090f\u0902\u0964"],"Show description inside item":["\u0906\u0907\u091f\u092e \u0915\u0947 \u0905\u0902\u0926\u0930 \u0935\u093f\u0935\u0930\u0923 \u0926\u093f\u0916\u093e\u090f\u0902"],"Show the short description inside the bundle item card. Disable this to hide it in the item box.":["\u092c\u0902\u0921\u0932 \u0906\u0907\u091f\u092e \u0915\u093e\u0930\u094d\u0921 \u0915\u0947 \u0905\u0902\u0926\u0930 \u0938\u0902\u0915\u094d\u0937\u093f\u092a\u094d\u0924 \u0935\u093f\u0935\u0930\u0923 \u0926\u093f\u0916\u093e\u090f\u0902\u0964 \u0906\u0907\u091f\u092e \u092c\u0949\u0915\u094d\u0938 \u092e\u0947\u0902 \u0907\u0938\u0947 \u091b\u093f\u092a\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0907\u0938\u0947 \u0905\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902\u0964"],"Prepend parent name":["\u092e\u0942\u0932 \u0928\u093e\u092e \u092a\u0939\u0932\u0947 \u0932\u0917\u093e\u090f\u0902"],"Prepend the parent name to the item name in the cart and order.":["\u0915\u093e\u0930\u094d\u091f \u0914\u0930 \u0911\u0930\u094d\u0921\u0930 \u092e\u0947\u0902 \u0906\u0907\u091f\u092e \u0915\u0947 \u0928\u093e\u092e \u0938\u0947 \u092a\u0939\u0932\u0947 \u092e\u0942\u0932 \u092