0940\u091a\u0947 \u0909\u0924\u094d\u092a\u093e\u0926 \u0938\u0942\u091a\u0940 \u0926\u093f\u0916\u093e\u090f\u0902\u0964"],"Show total price":["\u0915\u0941\u0932 \u092e\u0942\u0932\u094d\u092f \u0926\u093f\u0916\u093e\u090f\u0902"],"Show the total price of the selected items below the products list.":["\u091a\u092f\u0928\u093f\u0924 \u0906\u0907\u091f\u092e \u0915\u093e \u0915\u0941\u0932 \u092e\u0942\u0932\u094d\u092f \u0909\u0924\u094d\u092a\u093e\u0926 \u0938\u0942\u091a\u0940 \u0915\u0947 \u0928\u0940\u091a\u0947 \u0926\u093f\u0916\u093e\u090f\u0902\u0964"],"Show saved money":["\u092c\u091a\u093e\u0908 \u0917\u0908 \u0930\u093e\u0936\u093f \u0926\u093f\u0916\u093e\u090f\u0902"],"Show the saved money when calculating the total price.":["\u0915\u0941\u0932 \u092e\u0942\u0932\u094d\u092f \u0915\u0940 \u0917\u0923\u0928\u093e \u0915\u0930\u0924\u0947 \u0938\u092e\u092f \u092c\u091a\u093e\u0908 \u0917\u0908 \u0930\u093e\u0936\u093f \u0926\u093f\u0916\u093e\u090f\u0902\u0964"],"Show Discount Badge":["\u0921\u093f\u0938\u094d\u0915\u093e\u0909\u0902\u091f \u092c\u0948\u091c \u0926\u093f\u0916\u093e\u090f\u0901"],"Show or hide the discount badge in the bundle total price section.":["\u092c\u0902\u0921\u0932 \u0915\u0941\u0932 \u092e\u0942\u0932\u094d\u092f \u0938\u0947\u0915\u094d\u0936\u0928 \u092e\u0947\u0902 \u0921\u093f\u0938\u094d\u0915\u093e\u0909\u0902\u091f \u092c\u0948\u091c \u0926\u093f\u0916\u093e\u090f\u0901 \u092f\u093e \u091b\u093f\u092a\u093e\u090f\u0901\u0964"],"Show selected product quick view":["\u091a\u092f\u0928\u093f\u0924 \u0909\u0924\u094d\u092a\u093e\u0926 \u0915\u093e \u0915\u094d\u0935\u093f\u0915 \u0935\u094d\u092f\u0942 \u0926\u093f\u0916\u093e\u090f\u0902"],"Show product quick view icon in the selected product.":["\u091a\u092f\u0928\u093f\u0924 \u0909\u0924\u094d\u092a\u093e\u0926 \u092e\u0947\u0902 \u0915\u094d\u0935\u093f\u0915 \u0935\u094d\u092f\u0942 \u0906\u0907\u0915\u0928 \u0926\u093f\u0916\u093e\u090f\u0902\u0964"],"Quantity field on item":["\u0906\u0907\u091f\u092e \u092a\u0930 \u092e\u093e\u0924\u094d\u0930\u093e \u092b\u093c\u0940\u0932\u094d\u0921"],"Show quantity field on item.":["\u0906\u0907\u091f\u092e \u092a\u0930 \u092e\u093e\u0924\u094d\u0930\u093e \u092b\u093c\u0940\u0932\u094d\u0921 \u0926\u093f\u0916\u093e\u090f\u0902\u0964"],"Show plus icon":["\u092a\u094d\u0932\u0938 \u0906\u0907\u0915\u0928 \u0926\u093f\u0916\u093e\u090f\u0902"],"Show plus icon between items.":["\u0906\u0907\u091f\u092e\u094d\u0938 \u0915\u0947 \u092c\u0940\u091a \u092a\u094d\u0932\u0938 \u0906\u0907\u0915\u0928 \u0926\u093f\u0916\u093e\u090f\u0902\u0964"],"Calculate bundle price in frontend":["\u092b\u094d\u0930\u0902\u091f\u090f\u0902\u0921 \u092e\u0947\u0902 \u092a\u0948\u0915\u0947\u091c \u0915\u0940 \u0915\u0940\u092e\u0924 \u0915\u0940 \u0917\u0923\u0928\u093e \u0915\u0930\u0947\u0902"],"It can enhance compatibility with discount plugin, but may lead to memory issues if the bundle contains many items. It is useful for dynamic price bundles. Only enable it if necessary.":["\u092f\u0939 \u0921\u093f\u0938\u094d\u0915\u093e\u0909\u0902\u091f \u092a\u094d\u0932\u0917\u0907\u0928 \u0915\u0947 \u0938\u093e\u0925 \u0938\u0902\u0917\u0924\u0924\u093e \u0915\u094b \u092c\u0922\u093c\u093e \u0938\u0915\u0924\u093e \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u092f\u0926\u093f \u092a\u0948\u0915\u0947\u091c \u092e\u0947\u0902 \u092c\u0939\u0941\u0924 \u0938\u093e\u0930\u0940 \u0935\u0938\u094d\u0924\u0941\u090f\u0902 \u0939\u0948\u0902 \u0924\u094b \u092f\u0939 \u092e\u0947\u092e\u094b\u0930\u0940 \u0938\u092e\u0938\u094d\u092f\u093e\u090f\u0901 \u092a\u0948\u0926\u093e \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u092f\u0939 \u0921\u093e\u092f\u0928\u0947\u092e\u093f\u0915 \u092a\u094d\u0930\u093e\u0907\u0938 \u092a\u0948\u0915\u0947\u091c\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0909\u092a\u092f\u094b\u0917\u0940 \u0939\u0948\u0964 \u0915\u0947\u0935\u0932 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u094b\u0928\u0947 \u092a\u0930 \u0939\u0940 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902\u0964"],"Theme":["\u0925\u0940\u092e"],"Grid 1":["\u0917\u094d\u0930\u093f\u0921 1"],"Grid 2":["\u0917\u094d\u0930\u093f\u0921 2"],"List 1":["\u0938\u0942\u091a\u0940 1"],"List 2":["\u0938\u0942\u091a\u0940 2"],"Size":["\u0906\u0915\u093e\u0930"],"Small":["\u091b\u094b\u091f\u093e"],"Medium":["\u092e\u0927\u094d\u092f\u092e"],"Large":["\u092c\u0921\u093c\u093e"],"Optional item mode":["\u0935\u0948\u0915\u0932\u094d\u092a\u093f\u0915 \u0906\u0907\u091f\u092e \u092e\u094b\u0921"],"Checkbox":["\u091a\u0947\u0915\u092c\u0949\u0915\u094d\u0938"],"Delete button":["\u0939\u091f\u093e\u0928\u0947 \u0915\u093e \u092c\u091f\u0928"],"Product bundle price on shop page":["\u0926\u0941\u0915\u093e\u0928 \u092a\u0943\u0937\u094d\u0920 \u092a\u0930 \u0909\u0924\u094d\u092a\u093e\u0926 \u092c\u0902\u0921\u0932 \u092e\u0942\u0932\u094d\u092f"],"Total price":["\u0915\u0941\u0932 \u092e\u0942\u0932\u094d\u092f"],"From total price":["\u0915\u0941\u0932 \u092e\u0942\u0932\u094d\u092f \u0938\u0947"],"From min price":["\u0928\u094d\u092f\u0942\u0928\u0924\u092e \u092e\u0942\u0932\u094d\u092f \u0938\u0947"],"Set how to show the product bundle price on the shop page.":["\u0926\u0941\u0915\u093e\u0928 \u092a\u0943\u0937\u094d\u0920 \u092a\u0930 \u0909\u0924\u094d\u092a\u093e\u0926 \u092c\u0902\u0921\u0932 \u092e\u0942\u0932\u094d\u092f \u0926\u093f\u0916\u093e\u0928\u0947 \u0915\u093e \u0924\u0930\u0940\u0915\u093e \u0938\u0947\u091f \u0915\u0930\u0947\u0902\u0964"],"Item price":["\u0906\u0907\u091f\u092e \u092e\u0942\u0932\u094d\u092f"],"Product price":["\u0909\u0924\u094d\u092a\u093e\u0926 \u092e\u0942\u0932\u094d\u092f"],"Product subtotal":["\u0909\u0924\u094d\u092a\u093e\u0926 \u0909\u092a-\u092e\u0942\u0932\u094d\u092f"],"Set how to show the product price in item.":["\u0906\u0907\u091f\u092e \u092e\u0947\u0902 \u0909\u0924\u094d\u092a\u093e\u0926 \u092e\u0942\u0932\u094d\u092f \u0926\u093f\u0916\u093e\u0928\u0947 \u0915\u093e \u0924\u0930\u0940\u0915\u093e \u0938\u0947\u091f \u0915\u0930\u0947\u0902\u0964"],"Product list price":["\u0909\u0924\u094d\u092a\u093e\u0926 \u0938\u0942\u091a\u0940 \u092e\u0942\u0932\u094d\u092f"],"Set how to show the product price in product list.":["\u0909\u0924\u094d\u092a\u093e\u0926 \u0938\u0942\u091a\u0940 \u092e\u0947\u0902 \u0909\u0924\u094d\u092a\u093e\u0926 \u092e\u0942\u0932\u094d\u092f \u0926\u093f\u0916\u093e\u0928\u0947 \u0915\u093e \u0924\u0930\u0940\u0915\u093e \u0938\u0947\u091f \u0915\u0930\u0947\u0902\u0964"],"Link to product":["\u0909\u0924\u094d\u092a\u093e\u0926 \u0938\u0947 \u0932\u093f\u0902\u0915"],"New tab":["\u0928\u092f\u093e \u091f\u0948\u092c"],"No link":["\u0915\u094b\u0908 \u0932\u093f\u0902\u0915 \u0928\u0939\u0940\u0902"],"Show the product change popup":["\u0909\u0924\u094d\u092a\u093e\u0926 \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928 \u092a\u0949\u092a-\u0905\u092a \u0926\u093f\u0916\u093e\u090f\u0902\u0964"],"Coupon apply method":["\u0915\u0942\u092a\u0928 \u0932\u093e\u0917\u0942 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0935\u093f\u0927\u093f"],"Both of bundle and bundle items":["\u092c\u0902\u0921\u0932 \u0914\u0930 \u092c\u0902\u0921\u0932 \u0906\u0907\u091f\u092e \u0926\u094b\u0928\u094b\u0902"],"On bundle":["\u0915\u0947\u0935\u0932 \u092c\u0902\u0921\u0932 \u092a\u0930"],"On bundle items":["\u0915\u0947\u0935\u0932 \u092c\u0902\u0921\u0932 \u0906\u0907\u091f\u092e \u092a\u0930"],"None of bundle and bundle items":["\u0928 \u0924\u094b \u092c\u0902\u0921\u0932 \u0914\u0930 \u0928 \u0939\u0940 \u092c\u0902\u0921\u0932 \u0906\u0907\u091f\u092e"],"Product based coupons apply method. Can apply on \"bundle\", \"bundle items\", \"both\" or \"none\".":["\u0909\u0924\u094d\u092a\u093e\u0926 \u0906\u0927\u093e\u0930\u093f\u0924 \u0915\u0942\u092a\u0928 \u0932\u093e\u0917\u0942 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0935\u093f\u0927\u093f\u0964 \u0907\u0938\u0947 \"\u092c\u0902\u0921\u0932\", \"\u092c\u0902\u0921\u0932 \u0906\u0907\u091f\u092e\", \"\u0926\u094b\u0928\u094b\u0902\" \u092f\u093e \"\u0915\u094b\u0908 \u0928\u0939\u0940\u0902\" \u092a\u0930 \u0932\u093e\u0917\u0942 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964"],"Cart contents count":["\u0915\u093e\u0930\u094d\u091f \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0915\u0940 \u0917\u093f\u0928\u0924\u0940"],"Bundle items":["\u092c\u0902\u0921\u0932 \u0906\u0907\u091f\u092e"],"How to count bundle products in the cart? Count both of \"bundle and its items\" or \"only bundle\" or \"only bundle items\".":["\u0915\u093e\u0930\u094d\u091f \u092e\u0947\u0902 \u092c\u0902\u0921\u0932 \u0909\u0924\u094d\u092a\u093e\u0926\u094b\u0902 \u0915\u0940 \u0917\u093f\u0928\u0924\u0940 \u0915\u0948\u0938\u0947 \u0915\u0930\u0947\u0902? \"\u092c\u0902\u0921\u0932 \u0914\u0930 \u0907\u0938\u0915\u0947 \u0906\u0907\u091f\u092e\" \u0926\u094b\u0928\u094b\u0902 \u0915\u0940 \u0917\u093f\u0928\u0924\u0940 \u0915\u0930\u0947\u0902 \u092f\u093e \"\u0915\u0947\u0935\u0932 \u092c\u0902\u0921\u0932\" \u092f\u093e \"\u0915\u0947\u0935\u0932 \u092c\u0902\u0921\u0932 \u0906\u0907\u091f\u092e\" \u0915\u0940 \u0917\u093f\u0928\u0924\u0940 \u0915\u0930\u0947\u0902\u0964"],"Product price selector":["\u0909\u0924\u094d\u092a\u093e\u0926 \u092e\u0942\u0932\u094d\u092f \u091a\u092f\u0928\u0915\u0930\u094d\u0924\u093e"],"Add to cart button selector":["\u0915\u093e\u0930\u094d\u091f \u092e\u0947\u0902 \u091c\u094b\u0921\u093c\u0947\u0902 \u092c\u091f\u0928 \u091a\u092f\u0928\u0915\u0930\u094d\u0924\u093e"],"Change product popup":["\u0909\u0924\u094d\u092a\u093e\u0926 \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928 \u092a\u0949\u092a-\u0905\u092a"],"Disable popup":["\u092a\u0949\u092a\u0905\u092a \u0905\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902"],"Disable popup for items that have only one product.":["\u0910\u0938\u0947 \u0906\u0907\u091f\u092e\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u092a\u0949\u092a\u0905\u092a \u0905\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902 \u091c\u093f\u0928\u0915\u0947 \u092a\u093e\u0938 \u0915\u0947\u0935\u0932 \u090f\u0915 \u0909\u0924\u094d\u092a\u093e\u0926 \u0939\u0948\u0964"],"Popup Variable \u2018Show Options\u2019 Button":["\u092a\u0949\u092a\u0905\u092a \u092e\u0947\u0902 '\u0936\u094b \u0935\u093f\u0915\u0932\u094d\u092a' \u092c\u091f\u0928 \u0935\u0947\u0930\u093f\u090f\u092c\u0932 \u0909\u0924\u094d\u092a\u093e\u0926\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f"],"Show or hide the \u201cShow Options\u201d button for variable products inside the popup.":["\u092a\u0949\u092a\u0905\u092a \u0915\u0947 \u092d\u0940\u0924\u0930 \u0935\u0947\u0930\u093f\u090f\u092c\u0932 \u0909\u0924\u094d\u092a\u093e\u0926\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f '\u0936\u094b \u0935\u093f\u0915\u0932\u094d\u092a' \u092c\u091f\u0928 \u0926\u093f\u0916\u093e\u090f\u0901 \u092f\u093e \u091b\u0941\u092a\u093e\u090f\u0901"],"Show stock":["\u0938\u094d\u091f\u0949\u0915 \u0926\u093f\u0916\u093e\u090f\u0902"],"Show product Stock availability in popup.":["\u092a\u0949\u092a-\u0905\u092a \u092e\u0947\u0902 \u0909\u0924\u094d\u092a\u093e\u0926 \u0938\u094d\u091f\u0949\u0915 \u0915\u0940 \u0909\u092a\u0932\u092c\u094d\u0927\u0924\u093e \u0926\u093f\u0916\u093e\u090f\u0902\u0964"],"Show rating":["\u0930\u0947\u091f\u093f\u0902\u0917 \u0926\u093f\u0916\u093e\u090f\u0902"],"Show product rating in popup.":["\u092a\u0949\u092a-\u0905\u092a \u092e\u0947\u0902 \u0909\u0924\u094d\u092a\u093e\u0926 \u0930\u0947\u091f\u093f\u0902\u0917 \u0926\u093f\u0916\u093e\u090f\u0902\u0964"],"Show popup quick view":["\u092a\u0949\u092a-\u0905\u092a \u0915\u094d\u0935\u093f\u0915 \u0935\u094d\u092f\u0942 \u0926\u093f\u0916\u093e\u090f\u0902"],"Show product quick view icon in popup.":["\u092a\u0949\u092a-\u0905\u092a \u092e\u0947\u0902 \u0909\u0924\u094d\u092a\u093e\u0926 \u0915\u094d\u0935\u093f\u0915 \u0935\u094d\u092f\u0942 \u0906\u0907\u0915\u0928 \u0926\u093f\u0916\u093e\u090f\u0902\u0964"],"Show search field in popup":["\u092a\u0949\u092a\u0905\u092a \u0935\u093f\u0902\u0921\u094b \u092e\u0947\u0902 \u0916\u094b\u091c \u092b\u093c\u0940\u0932\u094d\u0921 \u0926\u093f\u0916\u093e\u090f\u0902"],"This option allows you to show or hide the product search field in the popup window.":["\u092f\u0939 \u0935\u093f\u0915\u0932\u094d\u092a \u0906\u092a\u0915\u094b \u092a\u0949\u092a\u0905\u092a \u0935\u093f\u0902\u0921\u094b \u092e\u0947\u0902 \u0909\u0924\u094d\u092a\u093e\u0926 \u0916\u094b\u091c \u092b\u093c\u0940\u0932\u094d\u0921 \u0926\u093f\u0916\u093e\u0928\u0947 \u092f\u093e \u091b\u093f\u092a\u093e\u0928\u0947 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0947\u0924\u093e \u0939\u0948\u0964"],"Show Variable Dropdown in Popup":["\u092a\u0949\u092a\u0905\u092a \u092e\u0947\u0902 \u0935\u0947\u0930\u093f\u090f\u092c\u0932 \u0921\u094d\u0930\u0949\u092a\u0921\u093e\u0909\u0928 \u092e\u0947\u0928\u0942 \u0926\u093f\u0916\u093e\u090f\u0901"],"Enable this option to display the dropdown menu for variable products in the popup.":["\u0907\u0938 \u0935\u093f\u0915\u0932\u094d\u092a \u0915\u094b \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902 \u0924\u093e\u0915\u093f \u092a\u0949\u092a\u0905\u092a \u092e\u0947\u0902 \u0935\u0947\u0930\u093f\u090f\u092c\u0932 \u0909\u0924\u094d\u092a\u093e\u0926\u094b\u0902 \u0915\u093e \u0921\u094d\u0930\u0949\u092a\u0921\u093e\u0909\u0928 \u092e\u0947\u0928\u0942 \u0926\u093f\u0916\u0947\u0964"],"Click on product in pop-up":["\u092a\u0949\u092a-\u0905\u092a \u092e\u0947\u0902 \u0909\u0924\u094d\u092a\u093e\u0926 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902"],"Product selection":["\u0909\u0924\u094d\u092a\u093e\u0926 \u091a\u092f\u0928"],"Show product details":["\u0909\u0924\u094d\u092a\u093e\u0926 \u0935\u093f\u0935\u0930\u0923 \u0926\u093f\u0916\u093e\u090f\u0902"],"Number of products per page":["\u092a\u094d\u0930\u0924\u093f \u092a\u0943\u0937\u094d\u0920 \u0909\u0924\u094d\u092a\u093e\u0926\u094b\u0902 \u0915\u0940 \u0938\u0902\u0916\u094d\u092f\u093e"],"Set how many products are displayed per page in the popup.":["\u092a\u0949\u092a\u0905\u092a \u092e\u0947\u0902 \u092a\u094d\u0930\u0924\u093f \u092a\u0947\u091c \u0915\u093f\u0924\u0928\u0947 \u0909\u0924\u094d\u092a\u093e\u0926 \u0926\u093f\u0916\u093e\u090f \u091c\u093e\u090f\u0902, \u0928\u093f\u0930\u094d\u0927\u093e\u0930\u093f\u0924 \u0915\u0930\u0947\u0902\u0964"],"Styles":["\u0936\u0948\u0932\u093f\u092f\u093e\u0902"],"There was an error on applying review.":["\u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0932\u093e\u0917\u0942 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0924\u094d\u0930\u0941\u091f\u093f \u0939\u0941\u0908\u0964"],"There was an error on getting settings.":["\u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0924\u094d\u0930\u0941\u091f\u093f \u0939\u0941\u0908\u0964"],"Data is required.":["\u0921\u0947\u091f\u093e \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u0948\u0964"],"There was an error on saving settings.":["\u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0938\u0939\u0947\u091c\u0928\u0947 \u092e\u0947\u0902 \u0924\u094d\u0930\u0941\u091f\u093f \u0939\u0941\u0908\u0964"],"We hope you're enjoying %1$s! %3$s Could you please do us a BIG favor and give it a %2$s to help us spread the word and boost our motivation?%4$s %5$sShare your feature requests%6$s with the review, We always check them and try our best.":["\u0939\u092e\u0947\u0902 \u0909\u092e\u094d\u092e\u0940\u0926 \u0939\u0948 \u0915\u093f \u0906\u092a %1$s \u0915\u093e \u0906\u0928\u0902\u0926 \u0932\u0947 \u0930\u0939\u0947 \u0939\u0948\u0902! %3$s \u0915\u094d\u092f\u093e \u0906\u092a \u0939\u092e\u093e\u0930\u0940 \u092e\u0926\u0926 \u0915\u0930\u0928\u0947 \u0914\u0930 \u0939\u092e\u093e\u0930\u0947 \u0909\u0924\u094d\u0938\u093e\u0939 \u0915\u094b \u092c\u0922\u093c\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0907\u0938\u0947 %2$s \u0930\u0947\u091f\u093f\u0902\u0917 \u0926\u0947 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902?%4$s %5$s\u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u0947 \u0938\u093e\u0925 \u0905\u092a\u0928\u0947 \u092b\u0940\u091a\u0930 \u0905\u0928\u0941\u0930\u094b\u0927 \u0938\u093e\u091d\u093e \u0915\u0930\u0947\u0902%6$s, \u0939\u092e \u0939\u092e\u0947\u0936\u093e \u0909\u0928\u0915\u0940 \u091c\u093e\u0902\u091a \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0905\u092a\u0928\u093e \u0938\u0930\u094d\u0935\u0936\u094d\u0930\u0947\u0937\u094d\u0920 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964"],"OK, you deserve it!":["\u0920\u0940\u0915 \u0939\u0948, \u0906\u092a \u0907\u0938\u0915\u0947 \u0939\u0915\u0926\u093e\u0930 \u0939\u0948\u0902!"],"I already did":["\u092e\u0948\u0902\u0928\u0947 \u092a\u0939\u0932\u0947 \u0939\u0940 \u0915\u0930 \u0926\u093f\u092f\u093e"],"I need help":["\u092e\u0941\u091d\u0947 \u092e\u0926\u0926 \u091a\u093e\u0939\u093f\u090f"],"Never show again":["\u092b\u093f\u0930 \u0915\u092d\u0940 \u0928 \u0926\u093f\u0916\u093e\u090f\u0902"]}}}