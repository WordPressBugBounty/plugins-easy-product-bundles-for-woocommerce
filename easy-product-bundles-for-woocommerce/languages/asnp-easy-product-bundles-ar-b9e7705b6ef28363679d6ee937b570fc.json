],"New tab":["\u0639\u0644\u0627\u0645\u0629 \u062a\u0628\u0648\u064a\u0628 \u062c\u062f\u064a\u062f\u0629"],"No link":["\u0644\u0627 \u064a\u0648\u062c\u062f \u0627\u0631\u062a\u0628\u0627\u0637"],"Show the product change popup":["\u0639\u0631\u0636 \u0646\u0627\u0641\u0630\u0629 \u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u0645\u0646\u062a\u062c"],"Coupon apply method":["\u0637\u0631\u064a\u0642\u0629 \u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0642\u0633\u064a\u0645\u0629"],"Both of bundle and bundle items":["\u0639\u0644\u0649 \u0627\u0644\u062d\u0632\u0645\u0629 \u0628\u0623\u0643\u0645\u0644\u0647\u0627 \u0648\u0639\u0644\u0649 \u0639\u0646\u0627\u0635\u0631 \u0627\u0644\u062d\u0632\u0645\u0629"],"On bundle":["\u0639\u0644\u0649 \u0627\u0644\u062d\u0632\u0645\u0629 \u0641\u0642\u0637"],"On bundle items":["\u0639\u0644\u0649 \u0639\u0646\u0627\u0635\u0631 \u0627\u0644\u062d\u0632\u0645\u0629"],"None of bundle and bundle items":["\u0644\u0627 \u0634\u064a\u0621 \u0645\u0646 \u0639\u0646\u0627\u0635\u0631 \u0627\u0644\u062d\u0632\u0645\u0629 \u0648\u0627\u0644\u062d\u0632\u0645\u0629"],"Product based coupons apply method. Can apply on \"bundle\", \"bundle items\", \"both\" or \"none\".":["\u0637\u0631\u064a\u0642\u0629 \u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0642\u0633\u0627\u0626\u0645 \u0627\u0644\u0645\u0633\u062a\u0646\u062f\u0629 \u0625\u0644\u0649 \u0627\u0644\u0645\u0646\u062a\u062c. \u064a\u0645\u0643\u0646 \u062a\u0637\u0628\u064a\u0642\u0647\u0627 \u0639\u0644\u0649 \"\u0627\u0644\u062d\u0632\u0645\u0629\"\u060c \"\u0639\u0646\u0627\u0635\u0631 \u0627\u0644\u062d\u0632\u0645\u0629\"\u060c \"\u0643\u0644\u0627\u0647\u0645\u0627\" \u0623\u0648 \"\u0644\u0627 \u0634\u064a\u0621\"."],"Cart contents count":["\u0639\u062f\u062f \u0645\u062d\u062a\u0648\u064a\u0627\u062a \u0627\u0644\u0633\u0644\u0629"],"Bundle items":["\u0639\u0646\u0627\u0635\u0631 \u0627\u0644\u062d\u0632\u0645\u0629"],"How to count bundle products in the cart? Count both of \"bundle 