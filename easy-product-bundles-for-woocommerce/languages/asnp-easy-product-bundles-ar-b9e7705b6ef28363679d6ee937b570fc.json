p.":["\u0625\u0638\u0647\u0627\u0631 \u0623\u0648 \u0625\u062e\u0641\u0627\u0621 \u0632\u0631 \u00ab\u0639\u0631\u0636 \u0627\u0644\u062e\u064a\u0627\u0631\u0627\u062a\u00bb \u0644\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0627\u0644\u0645\u062a\u063a\u064a\u0631\u0629 \u062f\u0627\u062e\u0644 \u0627\u0644\u0646\u0627\u0641\u0630\u0629 \u0627\u0644\u0645\u0646\u0628\u062b\u0642\u0629"],"Show stock":["\u0625\u0638\u0647\u0627\u0631 \u0627\u0644\u0645\u062e\u0632\u0648\u0646"],"Show product Stock availability in popup.":["\u0639\u0631\u0636 \u062a\u0648\u0627\u0641\u0631 \u0627\u0644\u0645\u0646\u062a\u062c \u0641\u064a \u0646\u0627\u0641\u0630\u0629 \u0645\u0646\u0628\u062b\u0642\u0629."],"Show rating":["\u0625\u0638\u0647\u0627\u0631 \u0627\u0644\u062a\u0642\u064a\u064a\u0645"],"Show product rating in popup.":["\u0625\u0638\u0647\u0627\u0631 \u062a\u0642\u064a\u064a\u0645 \u0627\u0644\u0645\u0646\u062a\u062c \u0641\u064a \u0646\u0627\u0641\u0630\u0629 \u0645\u0646\u0628\u062b\u0642\u0629."],"Show popup quick view":["\u0625\u0638\u0647\u0627\u0631 \u0627\u0644\u0639\u0631\u0636 \u0627\u0644\u0633\u0631\u064a\u0639 \u0641\u064a \u0646\u0627\u0641\u0630\u0629 \u0645\u0646\u0628\u062b\u0642\u0629"],"Show product quick view icon in popup.":["\u0625\u0638\u0647\u0627\u0631 \u0623\u064a\u0642\u0648\u0646\u0629 \u0627\u0644\u0639\u0631\u0636 \u0627\u0644\u0633\u0631\u064a\u0639 \u0644\u0644\u0645\u0646\u062a\u062c \u0641\u064a \u0627\u0644\u0646\u0627\u0641\u0630\u0629 \u0627\u0644\u0645\u0646\u0628\u062b\u0642\u0629"],"Show search field in popup":["\u0625\u0638\u0647\u0627\u0631 \u062d\u0642\u0644 \u0627\u0644\u0628\u062d\u062b \u0641\u064a \u0627\u0644\u0646\u0627\u0641\u0630\u0629 \u0627\u0644\u0645\u0646\u0628\u062b\u0642\u0629"],"This option allows you to show or hide the product search field in the popup window.":["\u064a\u062a\u064a\u062d \u0644\u0643 \u0647\u0630\u0627 \u0627\u0644\u062e\u064a\u0627\u0631 \u0625\u0638\u0647\u0627\u0631 \u0623\u0648 \u0625\u062e\u0641\u0627\u0621 \u062d\u0642\u0644 \u0627\u0644\u0628\u062d\u062b \u0639\u0646 \u0627\u0644\u0645\u0646\u062a\u062c \u0641\u064a \u0627\u0644\u0646\u0627\u0641\u0630\u0629 \u0627\u0644\u0645\u0646\u0628\u062b\u0642\u0629."],"Show Variable Dropdown in Popup":["\u0639\u0631\u0636 \u0627\u0644\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0646\u0633\u062f\u0644\u0629 \u0644\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0627\u0644\u0645\u062a\u063a\u064a\u0631\u0629 \u0641\u064a \u0627\u0644\u0646\u0627\u0641\u0630\u0629 \u0627\u0644\u0645\u0646\u0628\u062b\u0642\u0629"],"Enable this option to display the dropdown menu for variable products in the popup.":["\u0641\u0639\u0651\u0644 \u0647\u0630\u0627 \u0627\u0644\u062e\u064a\u0627\u0631 \u0644\u0639\u0631\u0636 \u0627\u0644\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0646\u0633\u062f\u0644\u0629 \u0644\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0627\u0644\u0645\u062a\u063a\u064a\u0631\u0629 \u0641\u064a \u0627\u0644\u0646\u0627\u0641\u0630\u0629 \u0627\u0644\u0645\u0646\u0628\u062b\u0642\u0629."],"Click on product in pop-up":["\u0627\u0646\u0642\u0631 \u0639\u0644\u0649 \u0627\u0644\u0645\u0646\u062a\u062c \u0641\u064a \u0627\u0644\u0646\u0627\u0641\u0630\u0629 \u0627\u0644\u0645\u0646\u0628\u062b\u0642\u0629"],"Product selection":["\u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u0645\u0646\u062a\u062c"],"Show product details":["\u0639\u0631\u0636 \u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0645\u0646\u062a\u062c"],"Number of products per page":["\u0639\u062f\u062f \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0641\u064a \u0627\u0644\u0635\u0641\u062d\u0629"],"Set how many products are displayed per page in the popup.":["\u062d\u062f\u062f \u0639\u062f\u062f \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0627\u0644\u0645\u0639\u0631\u0648\u0636\u0629 \u0641\u064a \u0643\u0644 \u0635\u0641\u062d\u0629 \u0645\u0646 \u0627\u0644\u0646\u0627\u0641\u0630\u0629 \u0627\u0644\u0645\u0646\u0628\u062b\u0642\u0629."],"Styles":["\u0627\u0644\u0623\u0646\u0645\u0627\u0637"],"There was an error on applying review.":["\u062d\u062f\u062b \u062e\u0637\u0623 \u0623\u062b\u0646\u0627\u0621 \u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u062a\u0642\u064a\u064a\u0645."],"There was an error on getting settings.":["\u062d\u062f\u062b \u062e\u0637\u0623 \u0623\u062b\u0646\u0627\u0621 \u062c\u0644\u0628 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a."],"Data is required.":["\u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0645\u0637\u0644\u0648\u0628\u0629."],"There was an error on saving settings.":["\u062d\u062f\u062b \u062e\u0637\u0623 \u0623\u062b\u0646\u0627\u0621 \u062d\u0641\u0638 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a."],"We hope you're enjoying %1$s! %3$s Could you please do us a BIG favor and give it a %2$s to help us spread the word and boost our motivation?%4$s %5$sShare your feature requests%6$s with the review, We always check them and try our best.":["\u0646\u0623\u0645\u0644 \u0623\u0646\u0643 \u062a\u0633\u062a\u0645\u062a\u0639 \u0628\u0640 %1$s! %3$s \u0647\u0644 \u064a\u0645\u0643\u0646\u0643 \u062a\u0642\u062f\u064a\u0645 \u0645\u0639\u0631\u0648\u0641 \u0643\u0628\u064a\u0631 \u0644\u0646\u0627 \u0648\u062a\u0642\u064a\u064a\u0645\u0647 \u0628\u0640 %2$s \u0644\u0645\u0633\u0627\u0639\u062f\u062a\u0646\u0627 \u0641\u064a \u0646\u0634\u0631 \u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0648\u062a\u0634\u062c\u064a\u0639\u0646\u0627\u061f%4$s %5$s\u0634\u0627\u0631\u0643 \u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0645\u064a\u0632\u0627\u062a \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0643%6$s \u0645\u0639 \u0627\u0644\u062a\u0642\u064a\u064a\u0645\u060c \u0641\u0646\u062d\u0646 \u0646\u0631\u0627\u062c\u0639\u0647\u0627 \u062f\u0627\u0626\u0645\u064b\u0627 \u0648\u0646\u0628\u0630\u0644 \u0642\u0635\u0627\u0631\u0649 \u062c\u0647\u062f\u0646\u0627."],"OK, you deserve it!":["\u062d\u0633\u0646\u064b\u0627\u060c \u0623\u0646\u062a\u0645 \u062a\u0633\u062a\u062d\u0642\u0648\u0646 \u0630\u0644\u0643!"],"I already did":["\u0644\u0642\u062f \u0642\u0645\u062a \u0628\u0630\u0644\u0643 \u0628\u0627\u0644\u0641\u0639\u0644"],"I need help":["\u0623\u062d\u062a\u0627\u062c \u0625\u0644\u0649 \u0645\u0633\u0627\u0639\u062f\u0629"],"Never show again":["\u0639\u062f\u0645 \u0627\u0644\u0625\u0638\u0647\u0627\u0631 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649"]}}}