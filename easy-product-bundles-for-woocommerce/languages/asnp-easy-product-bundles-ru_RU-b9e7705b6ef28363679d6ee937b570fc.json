041d\u043e\u0432\u0430\u044f \u0432\u043a\u043b\u0430\u0434\u043a\u0430"],"No link":["\u0411\u0435\u0437 \u0441\u0441\u044b\u043b\u043a\u0438"],"Show the product change popup":["\u041f\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u0432\u0441\u043f\u043b\u044b\u0432\u0430\u044e\u0449\u0435\u0435 \u043e\u043a\u043d\u043e \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430"],"Coupon apply method":["\u041c\u0435\u0442\u043e\u0434 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u043a\u0443\u043f\u043e\u043d\u0430"],"Both of bundle and bundle items":["\u041e\u0431\u0430: \u0441\u0432\u044f\u0437\u043a\u0438 \u0438 \u0442\u043e\u0432\u0430\u0440\u044b \u0432 \u0441\u0432\u044f\u0437\u043a\u0435"],"On bundle":["\u041d\u0430 \u0441\u0432\u044f\u0437\u043a\u0435"],"On bundle items":["\u041d\u0430 \u0442\u043e\u0432\u0430\u0440\u0430\u0445 \u0432 \u0441\u0432\u044f\u0437\u043a\u0435"],"None of bundle and bundle items":["\u041d\u0438 \u0441\u0432\u044f\u0437\u043a\u0438, \u043d\u0438 \u0442\u043e\u0432\u0430\u0440\u044b \u0432 \u0441\u0432\u044f\u0437\u043a\u0435"],"Product based coupons apply method. Can apply on \"bundle\", \"bundle items\", \"both\" or \"none\".":["\u041c\u0435\u0442\u043e\u0434 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u043a\u0443\u043f\u043e\u043d\u043e\u0432 \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u043e\u0432. \u041c\u043e\u0436\u043d\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0442\u044c \u043d\u0430 \"\u0441\u0432\u044f\u0437\u043a\u0435\", \"\u0442\u043e\u0432\u0430\u0440\u0430\u0445 \u0432 \u0441\u0432\u044f\u0437\u043a\u0435\", \"\u043e\u0431\u043e\u0438\u0445\" \u0438\u043b\u0438 \"\u043d\u0438 \u043d\u0430 \u0447\u0435\u043c\"."],"Cart contents count":["\u041a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0442\u043e\u0432\u0430\u0440\u043e\u0432 \u0432 \u043a\u043e\u0440\u0437\u0438\u043d\u0435"],"Bundle items":["\u0422\u043e\u0432\u0430\u0440\u044b \u0432 \u0441\u0432\u044f\u0437\u043a\u0435"],"How to count bundle products in the cart? Count both of \"bundle and its items\" or \"only bundle\" or \"only bundle items\".":["\u041a\u0430\u043a \u0441\u0447\u0438\u0442\u0430\u0442\u044c \u0442\u043e\u0432\u0430\u0440\u044b \u0432 \u0441\u0432\u044f\u0437\u043a\u0435 \u0432 \u043a\u043e\u0440\u0437\u0438\u043d\u0435? \u0421\u0447\u0438\u0442\u0430\u0442\u044c \u043a\u0430\u043a \"\u0441\u0432\u044f\u0437\u043a\u0443 \u0438 \u0435\u0435 \u0442\u043e\u0432\u0430\u0440\u044b\", \"\u0442\u043e\u043b\u044c\u043a\u043e \u0441\u0432\u044f\u0437\u043a\u0443\" \u0438\u043b\u0438 \"\u0442\u043e\u043b\u044c\u043a\u043e \u0442\u043e\u0432\u0430\u0440\u044b \u0432 \u0441\u0432\u044f\u0437\u043a\u0435\"."],"Product price selector":["\u0421\u0435\u043b\u0435\u043a\u0442\u043e\u0440 \u0446\u0435\u043d\u044b \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430"],"Add to cart button selector":["\u0421\u0435\u043b\u0435\u043a\u0442\u043e\u0440 \u043a\u043d\u043e\u043f\u043a\u0438 \u0414\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u0432 \u043a\u043e\u0440\u0437\u0438\u043d\u0443"],"Change product popup":["\u0412\u0441\u043f\u043b\u044b\u0432\u0430\u044e\u0449\u0435\u0435 \u043e\u043a\u043d\u043e \u0434\u043b\u044f \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430"],"Disable popup":["\u041e\u0442\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u0432\u0441\u043f\u043b\u044b\u0432\u0430\u044e\u0449\u0435\u0435 \u043e\u043a\u043d\u043e"],"Disable popup for items that have only one product.":["\u041e\u0442\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u0432\u0441\u043f\u043b\u044b\u0432\u0430\u044e\u0449\u0435\u0435 \u043e\u043a\u043d\u043e \u0434\u043b\u044f \u0442\u043e\u0432\u0430\u0440\u043e\u0432, \u0443 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0435\u0441\u0442\u044c \u0442\u043e\u043b\u044c\u043a\u043e \u043e\u0434\u0438\u043d \u043f\u0440\u043e\u0434\u0443\u043a\u0442."],"Popup Variable \u2018Show Options\u2019 Button":["\u041a\u043d\u043e\u043f\u043a\u0430 \u00ab\u041f\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u044b\u00bb \u0432\u043e \u0432\u0441\u043f\u043b\u044b\u0432\u0430\u044e\u0449\u0435\u043c \u043e\u043a\u043d\u0435 \u0434\u043b\u044f \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u043e\u0432"],"Show or hide the \u201cShow Options\u201d button for variable products inside the popup.":["\u041f\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u0438\u043b\u0438 \u0441\u043a\u0440\u044b\u0442\u044c \u043a\u043d\u043e\u043f\u043a\u0443 \u00ab\u041f\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u044b\u00bb \u0434\u043b\u044f \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u043e\u0432 \u0432\u043e \u0432\u0441\u043f\u043b\u044b\u0432\u0430\u044e\u0449\u0435\u043c \u043e\u043a\u043d\u0435"],"Show stock":["\u041f\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u043d\u0430\u043b\u0438\u0447\u0438\u0435"],"Show product Stock availability in popup.":["\u041f\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u0442\u043e\u0432\u0430\u0440\u0430 \u0432\u043e \u0432\u0441\u043f\u043b\u044b\u0432\u0430\u044e\u0449\u0435\u043c \u043e\u043a\u043d\u0435."],"Show rating":["\u041f\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u0440\u0435\u0439\u0442\u0438\u043d\u0433"],"Show product rating in popup.":["\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0440\u0435\u0439\u0442\u0438\u043d\u0433 \u0442\u043e\u0432\u0430\u0440\u0430 \u0432\u043e \u0432\u0441\u043f\u043b\u044b\u0432\u0430\u044e\u0449\u0435\u043c \u043e\u043a\u043d\u0435."],"Show popup quick view":["\u041f\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u0431\u044b\u0441\u0442\u0440\u044b\u0439 \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440 \u0432\u043e \u0432\u0441\u043f\u043b\u044b\u0432\u0430\u044e\u0449\u0435\u043c \u043e\u043a\u043d\u0435"],"Show product quick view icon in popup.":["\u041f\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u0438\u043a\u043e\u043d\u043a\u0443 \u0431\u044b\u0441\u0442\u0440\u043e\u0433\u043e \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u0430 \u0442\u043e\u0432\u0430\u0440\u0430 \u0432\u043e \u0432\u0441\u043f\u043b\u044b\u0432\u0430\u044e\u0449\u0435\u043c \u043e\u043a\u043d\u0435"],"Show search field in popup":["\u041f\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u043f\u043e\u043b\u0435 \u043f\u043e\u0438\u0441\u043a\u0430 \u0432\u043e \u0432\u0441\u043f\u043b\u044b\u0432\u0430\u044e\u0449\u0435\u043c \u043e\u043a\u043d\u0435"],"This option allows you to show or hide the product search field in the popup window.":["\u042d\u0442\u043e\u0442 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0438\u043b\u0438 \u0441\u043a\u0440\u044b\u0432\u0430\u0442\u044c \u043f\u043e\u043b\u0435 \u043f\u043e\u0438\u0441\u043a\u0430 \u0442\u043e\u0432\u0430\u0440\u043e\u0432 \u0432\u043e \u0432\u0441\u043f\u043b\u044b\u0432\u0430\u044e\u0449\u0435\u043c \u043e\u043a\u043d\u0435."],"Show Variable Dropdown in Popup":["\u0412\u044b\u043f\u0430\u0434\u0430\u044e\u0449\u0435\u0435 \u043c\u0435\u043d\u044e \u0432\u0430\u0440\u0438\u0430\u0442\u0438\u0432\u043d\u044b\u0445 \u0442\u043e\u0432\u0430\u0440\u043e\u0432 \u0432 \u043f\u043e\u043f\u0430\u043f\u0435"],"Enable this option to display the dropdown menu for variable products in the popup.":["\u0412\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u044d\u0442\u0443 \u043e\u043f\u0446\u0438\u044e, \u0447\u0442\u043e\u0431\u044b \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u0442\u044c \u0432\u044b\u043f\u0430\u0434\u0430\u044e\u0449\u0435\u0435 \u043c\u0435\u043d\u044e \u0432\u0430\u0440\u0438\u0430\u0442\u0438\u0432\u043d\u044b\u0445 \u0442\u043e\u0432\u0430\u0440\u043e\u0432 \u0432\u043e \u0432\u0441\u043f\u043b\u044b\u0432\u0430\u044e\u0449\u0435\u043c \u043e\u043a\u043d\u0435."],"Click on product in pop-up":["\u041d\u0430\u0436\u043c\u0438\u0442\u0435 \u043d\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0442 \u0432\u043e \u0432\u0441\u043f\u043b\u044b\u0432\u0430\u044e\u0449\u0435\u043c \u043e\u043a\u043d\u0435"],"Product selection":["\u0412\u044b\u0431\u043e\u0440 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430"],"Show product details":["\u041f\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u0434\u0435\u0442\u0430\u043b\u0438 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430"],"Number of products per page":["\u041a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0442\u043e\u0432\u0430\u0440\u043e\u0432 \u043d\u0430 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0435"],"Set how many products are displayed per page in the popup.":["\u0423\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435, \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u043e\u0432 \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u0435\u0442\u0441\u044f \u043d\u0430 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0435 \u0432\u043e \u0432\u0441\u043f\u043b\u044b\u0432\u0430\u044e\u0449\u0435\u043c \u043e\u043a\u043d\u0435."],"Styles":["\u0421\u0442\u0438\u043b\u0438"],"There was an error on applying review.":["\u041f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u0430 \u043e\u0448\u0438\u0431\u043a\u0430 \u043f\u0440\u0438 \u043e\u0442\u043f\u0440\u0430\u0432\u043a\u0435 \u043e\u0442\u0437\u044b\u0432\u0430."],"There was an error on getting settings.":["\u041f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u0430 \u043e\u0448\u0438\u0431\u043a\u0430 \u043f\u0440\u0438 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u0438 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043a."],"Data is required.":["\u0414\u0430\u043d\u043d\u044b\u0435 \u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u044b."],"There was an error on saving settings.":["\u041f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u0430 \u043e\u0448\u0438\u0431\u043a\u0430 \u043f\u0440\u0438 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0438 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043a."],"We hope you're enjoying %1$s! %3$s Could you please do us a BIG favor and give it a %2$s to help us spread the word and boost our motivation?%4$s %5$sShare your feature requests%6$s with the review, We always check them and try our best.":["\u041c\u044b \u043d\u0430\u0434\u0435\u0435\u043c\u0441\u044f, \u0447\u0442\u043e \u0432\u0430\u043c \u043d\u0440\u0430\u0432\u0438\u0442\u0441\u044f %1$s! %3$s \u041d\u0435 \u043c\u043e\u0433\u043b\u0438 \u0431\u044b \u0432\u044b \u043e\u043a\u0430\u0437\u0430\u0442\u044c \u043d\u0430\u043c \u0431\u043e\u043b\u044c\u0448\u0443\u044e \u0443\u0441\u043b\u0443\u0433\u0443 \u0438 \u043e\u0446\u0435\u043d\u0438\u0442\u044c \u043d\u0430\u0441 \u043d\u0430 %2$s, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043c\u043e\u0447\u044c \u043d\u0430\u043c \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0438\u0442\u044c \u0441\u043b\u043e\u0432\u043e \u0438 \u0443\u0441\u0438\u043b\u0438\u0442\u044c \u043d\u0430\u0448\u0443 \u043c\u043e\u0442\u0438\u0432\u0430\u0446\u0438\u044e?%4$s %5$s\u041f\u043e\u0434\u0435\u043b\u0438\u0442\u0435\u0441\u044c \u0441\u0432\u043e\u0438\u043c\u0438 \u0437\u0430\u043f\u0440\u043e\u0441\u0430\u043c\u0438 \u0444\u0443\u043d\u043a\u0446\u0438\u0439%6$s \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043e\u0431\u0437\u043e\u0440\u0430. \u041c\u044b \u0432\u0441\u0435\u0433\u0434\u0430 \u0438\u0445 \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0435\u043c \u0438 \u0441\u0442\u0430\u0440\u0430\u0435\u043c\u0441\u044f \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0432\u0441\u0435 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0435."],"OK, you deserve it!":["\u041e\u041a, \u0432\u044b \u044d\u0442\u043e\u0433\u043e \u0437\u0430\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u0435\u0442\u0435!"],"I already did":["\u042f \u0443\u0436\u0435 \u043e\u0446\u0435\u043d\u0438\u043b"],"I need help":["\u041c\u043d\u0435 \u043d\u0443\u0436\u043d\u0430 \u043f\u043e\u043c\u043e\u0449\u044c"],"Never show again":["\u0411\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c"]}}}