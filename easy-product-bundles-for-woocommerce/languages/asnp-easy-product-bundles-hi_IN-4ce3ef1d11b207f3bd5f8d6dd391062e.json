92f"],"Discount applied to the price of the bundled product. if the bundled product has a sale price the discount is applied on top of the sale price":["\u092c\u0902\u0921\u0932 \u0909\u0924\u094d\u092a\u093e\u0926 \u0915\u0940 \u0915\u0940\u092e\u0924 \u092a\u0930 \u091b\u0942\u091f \u0932\u093e\u0917\u0942 \u0915\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \u092f\u0926\u093f \u092c\u0902\u0921\u0932 \u0909\u0924\u094d\u092a\u093e\u0926 \u0915\u093e \u092c\u093f\u0915\u094d\u0930\u0940 \u092e\u0942\u0932\u094d\u092f \u0939\u0948, \u0924\u094b \u091b\u0942\u091f \u092c\u093f\u0915\u094d\u0930\u0940 \u092e\u0942\u0932\u094d\u092f \u0915\u0947 \u090a\u092a\u0930 \u0932\u093e\u0917\u0942 \u0915\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964"],"Item %d":["\u0906\u0907\u091f\u092e %d"],"Duplicate: Pro version":["\u0928\u0915\u0932 \u0915\u0930\u0947\u0902: \u092a\u094d\u0930\u094b \u0938\u0902\u0938\u094d\u0915\u0930\u0923"],"Duplicate":["\u0928\u0915\u0932 \u0915\u0930\u0947\u0902"],"Trash":["\u0915\u091a\u0930\u093e"],"General":["\u0938\u093e\u092e\u093e\u0928\u094d\u092f"],"Display":["\u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928"],"Default Image":["\u0921\u093f\u092b\u093c\u0949\u0932\u094d\u091f \u091a\u093f\u0924\u094d\u0930"],"No image chosen":["\u0915\u094b\u0908 \u091a\u093f\u0924\u094d\u0930 \u0928\u0939\u0940\u0902 \u091a\u0941\u0928\u093e \u0917\u092f\u093e"],"Upload Image":["\u091a\u093f\u0924\u094d\u0930 \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0947\u0902"],"Set an image for empty item.":["\u0916\u093e\u0932\u0940 \u0906\u0907\u091f\u092e \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u091a\u093f\u0924\u094d\u0930 \u0938\u0947\u091f \u0915\u0930\u0947\u0902\u0964"],"Please enable fixed price first.":["\u0915\u0943\u092a\u092f\u093e \u092a\u0939\u0932\u0947 \u0928\u093f\u092f\u0924 \u092e\u0942\u0932\u094d\u092f \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902\u0964"],"Article":["\u0932\u0947\u0916"],"Quick Tutorial":["\u0924\u094d\u093