 bundle stock quantity based on the stock quantity of child products. Note: This feature works only when each item has exactly one product, which is added to the default product field and is not optional.":["\u092c\u0902\u0921\u0932 \u0938\u094d\u091f\u0949\u0915 \u092e\u093e\u0924\u094d\u0930\u093e \u0915\u094b \u091a\u093e\u0907\u0932\u094d\u0921 \u0909\u0924\u094d\u092a\u093e\u0926\u094b\u0902 \u0915\u0940 \u0938\u094d\u091f\u0949\u0915 \u092e\u093e\u0924\u094d\u0930\u093e \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0947\u0902\u0964 \u0928\u094b\u091f: \u092f\u0939 \u0938\u0941\u0935\u093f\u0927\u093e \u0915\u0947\u0935\u0932 \u0924\u092c \u0915\u093e\u092e \u0915\u0930\u0924\u0940 \u0939\u0948 \u091c\u092c \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0906\u0907\u091f\u092e \u092e\u0947\u0902 \u090f\u0915 \u0939\u0940 \u0909\u0924\u094d\u092a\u093e\u0926 \u0939\u094b, \u091c\u093f\u0938\u0947 \u0921\u093f\u092b\u093c\u0949\u0932\u094d\u091f \u0909\u0924\u094d\u092a\u093e\u0926 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u092e\u0947\u0902 \u091c\u094b\u0921\u093c\u093e \u0917\u092f\u093e \u0939\u094b \u0914\u0930 \u092f\u0939 \u0935\u0948\u0915\u0932\u094d\u092a\u093f\u0915 \u0928 \u0939\u094b\u0964"],"Hide products price":["\u0909\u0924\u094d\u092a\u093e\u0926 \u092e\u0942\u0932\u094d\u092f \u091b\u093f\u092a\u093e\u090f\u0902"],"No":["\u0928\u0939\u0940\u0902"],"Yes":["\u0939\u093e\u0902"],"Only regular price":["\u0915\u0947\u0935\u0932 \u0928\u093f\u092f\u092e\u093f\u0924 \u092e\u0942\u0932\u094d\u092f"],"Shipping fee":["\u0936\u093f\u092a\u093f\u0902\u0917 \u0936\u0941\u0932\u094d\u0915"],"Apply to the whole bundle":["\u092a\u0942\u0930\u0947 \u092c\u0902\u0921\u0932 \u092a\u0930 \u0932\u093e\u0917\u0942 \u0915\u0930\u0947\u0902"],"Apply to the parent product":["\u092e\u0941\u0916\u094d\u092f \u0909\u0924\u094d\u092a\u093e\u0926 \u092a\u0930 \u0932\u093e\u0917\u0942 \u0915\u0930\u0947\u0902"],"Apply to each bundle item":["\u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u092c\u0902\u0921\u0932 \u0906\u0907\u091f\u092e \u092a\u0930 \u0932\u093e\u0917\u0942 \u0915\u0930\u0947\u0902"],"Min items quantity":["\u0928\u094d\u092f\u0942\u0928\u0924\u092e \u0906\u0907\u091f\u092e \u092e\u093e\u0924\u094d\u0930\u093e"],"Set the minimum total quantity of bundled items.":["\u092c\u0902\u0921\u0932 \u0915\u093f\u090f \u0917\u090f \u0906\u0907\u091f\u092e \u0915\u0940 \u0928\u094d\u092f\u0942\u0928\u0924\u092e \u0915\u0941\u0932 \u092e\u093e\u0924\u094d\u0930\u093e \u0938\u0947\u091f \u0915\u0930\u0947\u0902\u0964"],"Max items quantity":["\u0905\u0927\u093f\u0915\u0924\u092e \u0906\u0907\u091f\u092e \u092e\u093e\u0924\u094d\u0930\u093e"],"Set the maximum total quantity of bundled items.":["\u092c\u0902\u0921\u0932 \u0915\u093f\u090f \u0917\u090f \u0906\u0907\u091f\u092e \u0915\u0940 \u0905\u0927\u093f\u0915\u0924\u092e \u0915\u0941\u0932 \u092e\u093e\u0924\u094d\u0930\u093e \u0938\u0947\u091f \u0915\u0930\u0947\u0902\u0964"],"Custom display price":["\u0915\u0938\u094d\u091f\u092e \u0921\u093f\u0938\u094d\u092a\u094d\u0932\u0947 \u092e\u0942\u0932\u094d\u092f"],"Product display price in frontend. E.g: From 10$ To 20$":["\u092b\u094d\u0930\u0902\u091f\u0947\u0902\u0921 \u092e\u0947\u0902 \u0909\u0924\u094d\u092a\u093e\u0926 \u0915\u093e \u0921\u093f\u0938\u094d\u092a\u094d\u0932\u0947 \u092e\u0942\u0932\u094d\u092f\u0964 \u0909\u0926\u093e\u0939\u0930\u0923: 10$ \u0938\u0947 20$ \u0924\u0915"],"A title for the bundle product that will be shown on top of bundle items.":["\u092c\u0902\u0921\u0932 \u0909\u0924\u094d\u092a\u093e\u0926 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0936\u0940\u0930\u094d\u0937\u0915 \u091c\u094b \u092c\u0902\u0921\u0932 \u0906\u0907\u091f\u092e\u094d\u0938 \u0915\u0947 \u090a\u092a\u0930 \u0926\u093f\u0916\u093e\u0908 \u0926\u0947\u0917\u093e\u0964"],"Bundle description":["\u092c\u0902\u0921\u0932 \u0935\u093f\u0935\u0930\u0923"],"Create a description for product bundle.":["\u0909\u0924\u094d\u092a\u093e\u0926 \u092c\u0902\u0921\u0932 \u0915\u0947 \u0932\u093f\u090f \u0935\u093f\u0935\u0930\u0923 \u092c\u0928\u093e\u090f\u0902\u0964"],"Bundle button label (shop page)":["\u092c\u0902\u0921\u0932 \u092c\u091f\u0928 \u0932\u0947\u092c\u0932 (\u0936\u0949\u092a \u092a\u0947\u091c)"],"Change the button label shown for bundle products in the shop page.":["\u0936\u0949\u092a \u092a\u0947\u091c \u092a\u0930 \u092c\u0902\u0921\u0932 \u0909\u0924\u094d\u092a\u093e\u0926\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0926\u093f\u0916\u093e\u090f \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0947 \u092c\u091f\u0928 \u0932\u0947\u092c\u0932 \u0915\u094b \u092c\u0926\u0932\u0947\u0902\u0964"],"Total discount":["\u0915\u0941\u0932 \u091b\u0942\u091f"],"Set a total discount for the bundle total price based on percentage or price.":["\u092a\u094d\u0930\u0924\u093f\u0936\u0924 \u092f\u093e \u0930\u093e\u0936\u093f \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930 \u092c\u0902\u0921\u0932 \u0915\u0940 \u0915\u0941\u0932 \u0915\u0940\u092e\u0924 \u0915\u0947 \u0932\u093f\u090f \u0915\u0941\u0932 \u091b\u0942\u091f \u0938\u0947\u091f \u0915\u0930\u0947\u0902\u0964"],"Add Item":["\u0906\u0907\u091f\u092e \u091c\u094b\u0921\u093c\u0947\u0902"]}}}