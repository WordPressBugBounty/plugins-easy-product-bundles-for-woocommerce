\u0909\u0924\u094d\u092a\u093e\u0926 \u092c\u093e\u0939\u0930 \u0915\u0930\u0947\u0902"],"Select a product that you do not want to be displayed":["\u0910\u0938\u093e \u0909\u0924\u094d\u092a\u093e\u0926 \u091a\u0941\u0928\u0947\u0902 \u091c\u093f\u0938\u0947 \u0906\u092a \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0928\u0939\u0940\u0902 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u0947\u0964"],"Categories":["\u0936\u094d\u0930\u0947\u0923\u093f\u092f\u093e\u0901"],"Select the category product that you want to be displayed in this bundle item":["\u0909\u0938 \u0936\u094d\u0930\u0947\u0923\u0940 \u0915\u0947 \u0909\u0924\u094d\u092a\u093e\u0926 \u0915\u093e \u091a\u092f\u0928 \u0915\u0930\u0947\u0902 \u091c\u093f\u0938\u0947 \u0906\u092a \u0907\u0938 \u092c\u0902\u0921\u0932 \u0906\u0907\u091f\u092e \u092e\u0947\u0902 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902\u0964"],"Exclude categories":["\u0936\u094d\u0930\u0947\u0923\u093f\u092f\u093e\u0901 \u092c\u093e\u0939\u0930 \u0915\u0930\u0947\u0902"],"Select the category product that you do not want to be displayed in this bundle item":["\u0909\u0938 \u0936\u094d\u0930\u0947\u0923\u0940 \u0915\u0947 \u0909\u0924\u094d\u092a\u093e\u0926 \u0915\u093e \u091a\u092f\u0928 \u0915\u0930\u0947\u0902 \u091c\u093f\u0938\u0947 \u0906\u092a \u0907\u0938 \u092c\u0902\u0921\u0932 \u0906\u0907\u091f\u092e \u092e\u0947\u0902 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0928\u0939\u0940\u0902 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u0947\u0964"],"Tags":["\u091f\u0948\u0917\u094d\u0938"],"Select the product with tags to display in this bundle item":["\u0907\u0938 \u092c\u0902\u0921\u0932 \u0906\u0907\u091f\u092e \u092e\u0947\u0902 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u091f\u0948\u0917\u094d\u0938 \u0915\u0947 \u0938\u093e\u0925 \u0909\u0924\u094d\u092a\u093e\u0926 \u091a\u0941\u0928\u0947\u0902\u0964"],"Exclude tags":["\u091f\u0948\u0917\u094d\u0938 \u092c\u093e\u0939\u0930 \u0915\u0930\u0947\u0902"],"Select the product with tags that you do not want to be displayed in the bundle item":["\u0910\u0938\u0947 \u091f\u0948\u0917\u094d\u0938 \u0935\u093e\u0932\u0947 \u0909\u0924\u094d\u092a\u093e\u0926 \u0915\u093e \u091a\u092f\u0928 \u0915\u0930\u0947\u0902 \u091c\u093f\u0938\u0947 \u0906\u092a \u092c\u0902\u0921\u0932 \u0906\u0907\u091f\u092e \u092e\u0947\u0902 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u093f\u0924 \u0928\u0939\u0940\u0902 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u0947\u0964"],"Categories and Tags relation":["\u0936\u094d\u0930\u0947\u0923\u093f\u092f\u093e\u0901 \u0914\u0930 \u091f\u0948\u0917\u094d\u0938 \u0915\u093e \u0938\u0902\u092c\u0902\u0927"],"Match at least one":["\u0915\u092e \u0938\u0947 \u0915\u092e \u090f\u0915 \u0938\u0947 \u092e\u0947\u0932 \u0916\u093e\u090f\u0902"],"Match both":["\u0926\u094b\u0928\u094b\u0902 \u0938\u0947 \u092e\u0947\u0932 \u0916\u093e\u090f\u0902"],"Match at least one: Products should match at least one of categories or tags.%sMatch both: Products should match both categories and tags.":["\u0915\u092e \u0938\u0947 \u0915\u092e \u090f\u0915 \u0938\u0947 \u092e\u0947\u0932 \u0916\u093e\u090f\u0902: \u0909\u0924\u094d\u092a\u093e\u0926\u094b\u0902 \u0915\u094b \u0936\u094d\u0930\u0947\u0923\u093f\u092f\u094b\u0902 \u092f\u093e \u091f\u0948\u0917\u094d\u0938 \u092e\u0947\u0902 \u0938\u0947 \u0915\u092e \u0938\u0947 \u0915\u092e \u090f\u0915 \u0938\u0947 \u092e\u0947\u0932 \u0916\u093e\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964%s\u0926\u094b\u0928\u094b\u0902 \u0938\u0947 \u092e\u0947\u0932 \u0916\u093e\u090f\u0902: \u0909\u0924\u094d\u092a\u093e\u0926\u094b\u0902 \u0915\u094b \u0936\u094d\u0930\u0947\u0923\u093f\u092f\u094b\u0902 \u0914\u0930 \u091f\u0948\u0917\u094d\u0938 \u0926\u094b\u0928\u094b\u0902 \u0938\u0947 \u092e\u0947\u0932 \u0916\u093e\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964"],"Use regular prices only":["\u0915\u0947\u0935\u0932 \u0928\u093f\u092f\u092e\u093f\u0924 \u0915\u0940\u092e\u0924\u094b\u0902 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902"],"Check this option to ignore sale prices and use only regular prices for item products and bundle pricing":["\u0938\u0947\u0932 \u0915\u0940\u092e\u0924\u094b\u0902 \u0915\u094b \u0905\u0928\u0926\u0947\u0916\u093e \u0915\u0930\u0928\u0947 \u0914\u0930 \u0909\u0924\u094d\u092a\u093e\u0926\u094b\u0902 \u0924\u0925\u093e \u092c\u0902\u0921\u0932 \u092e\u0942\u0932\u094d\u092f \u0928\u093f\u0930\u094d\u0927\u093e\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f \u0915\u0947\u0935\u0932 \u0928\u093f\u092f\u092e\u093f\u0924 \u0915\u0940\u092e\u0924\u094b\u0902 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u0947 \u0939\u0947\u0924\u0941 \u0907\u0938 \u0935\u093f\u0915\u0932\u094d\u092a \u0915\u094b \u091a\u0941\u0928\u0947\u0902\u0964"],"Sort products":["\u0909\u0924\u094d\u092a\u093e\u0926 \u0915\u094d\u0930\u092e\u092c\u0926\u094d\u0927 \u0915\u0930\u0947\u0902"],"ID":["\u0906\u0908\u0921\u0940"],"Menu order":["\u092e\u0947\u0928\u0942 \u0915\u094d\u0930\u092e"],"Date":["\u0924\u093e\u0930\u0940\u0916"],"Price":["\u092e\u0942\u0932\u094d\u092f"],"Popularity":["\u0932\u094b\u0915\u092a\u094d\u0930\u093f\u092f\u0924\u093e"],"Rating":["\u0930\u0947\u091f\u093f\u0902\u0917"],"Ascending":["\u0906\u0930\u094b\u0939\u0940"],"Descending":["\u0905\u0935\u0930\u094b\u0939\u0940"],"Set the order of products in the pop-up":["\u092a\u0949\u092a-\u0905\u092a \u092e\u0947\u0902 \u0909\u0924\u094d\u092a\u093e\u0926\u094b\u0902 \u0915\u093e \u0915\u094d\u0930\u092e \u0938\u0947\u091f \u0915\u0930\u0947\u0902"],"Quantity":["\u092e\u093e\u0924\u094d\u0930\u093e"],"Set the default product quantity":["\u0921\u093f\u092b\u093c\u0949\u0932\u094d\u091f \u0909\u0924\u094d\u092a\u093e\u0926 \u092e\u093e\u0924\u094d\u0930\u093e \u0